rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function agentPath(agentId) {
      return /databases/$(database)/documents/agents/$(agentId);
    }

    function authAgentPath() {
      return /databases/$(database)/documents/agents/$(request.auth.uid);
    }

    function authAgentEmailPath() {
      return /databases/$(database)/documents/agents/$(request.auth.token.email);
    }

    function hasAgent(agentId) {
      return signedIn() && exists(agentPath(agentId));
    }

    function hasAuthAgentDocument() {
      return signedIn() && exists(authAgentPath());
    }

    function hasAuthAgentEmailDocument() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email != '' &&
        exists(authAgentEmailPath());
    }

    function agentEmailMatches(agentId) {
      return hasAgent(agentId) &&
        (get(agentPath(agentId)).data.email == request.auth.token.email ||
         get(agentPath(agentId)).data.emailLower == request.auth.token.email);
    }

    function isSelfAgent(agentId) {
      return signedIn() &&
        (agentId == request.auth.uid || agentEmailMatches(agentId));
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDocument() {
      return signedIn() && exists(userPath());
    }

    function principalData() {
      return hasAuthAgentDocument()
        ? get(authAgentPath()).data
        : (
          hasAuthAgentEmailDocument()
            ? get(authAgentEmailPath()).data
            : (hasUserDocument() ? get(userPath()).data : request.auth.token)
        );
    }

    function isUser() {
      return itsmRole() in ['USER', 'user', 'User'];
    }

    function isManager() {
      return itsmRole() in ['MANAGER', 'manager', 'Manager'];
    }

    function isAdmin() {
      return itsmRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function hasIncidentAccess() {
      return isUser() || isManager() || isAdmin();
    }

    function itsmRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['ticketing'])
        ? permissions.ticketing
        : (
          permissions.keys().hasAny(['itsm'])
            ? permissions.itsm
            : (
              permissions.keys().hasAny(['it_service_management'])
                ? permissions.it_service_management
                : (
                  permissions.keys().hasAny(['itservicemanagement'])
                    ? permissions.itservicemanagement
                    : (
                      permissions.keys().hasAny(['support'])
                        ? permissions.support
                        : (
                          permissions.keys().hasAny(['incident'])
                            ? permissions.incident
                            : (
                              permissions.keys().hasAny(['incidents'])
                                ? permissions.incidents
                                : (
                                  permissions.keys().hasAny(['incident_management'])
                                    ? permissions.incident_management
                                    : (
                                      permissions.keys().hasAny(['incidentmanagement'])
                                        ? permissions.incidentmanagement
                                        : (
                                          permissions.keys().hasAny(['ticket'])
                                            ? permissions.ticket
                                            : (
                                              permissions.keys().hasAny(['tickets'])
                                                ? permissions.tickets
                                                : (
                                                  data.keys().hasAny(['incidentRole']) &&
                                                  data.incidentRole is string &&
                                                  data.incidentRole != ''
                                                    ? data.incidentRole
                                                    : 'NONE'
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        );
    }

    function isItsmSelfServiceRole() {
      return isUser() || isAdmin();
    }

    function isRestrictedItsmData(data) {
      return (
          data.keys().hasAny(['confidentiality']) &&
          data.confidentiality in [
            'RESTRICTED',
            'restricted',
            'SECURITY_RESTRICTED',
            'security_restricted',
            'CONFIDENTIAL',
            'confidential'
          ]
        ) ||
        (
          data.keys().hasAny(['isRestricted']) &&
          data.isRestricted == true
        );
    }

    function isExplicitlyAuthorizedForRestricted(data) {
      return signedIn() &&
        (
          (
            data.keys().hasAny(['authorizedUserIds']) &&
            data.authorizedUserIds is list &&
            request.auth.uid in data.authorizedUserIds
          ) ||
          (
            data.keys().hasAny(['assignedUserId']) &&
            data.assignedUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requesterId']) &&
            data.requesterId == request.auth.uid
          )
        );
    }

    function isPrincipalWorkItemOwner(data) {
      return signedIn() &&
        (
          (
            data.keys().hasAny(['requesterId']) &&
            data.requesterId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requesterEmail']) &&
            data.requesterEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['requestedForUserId']) &&
            data.requestedForUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requestedForEmail']) &&
            data.requestedForEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['createdByUserId']) &&
            data.createdByUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['createdByEmail']) &&
            data.createdByEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['affectedUserId']) &&
            data.affectedUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['affectedUserEmail']) &&
            data.affectedUserEmail == request.auth.token.email
          )
        );
    }

    function isSelfServiceVisible(data) {
      return !data.keys().hasAny(['selfServiceVisible']) ||
        data.selfServiceVisible == true;
    }

    function canReadItsmOperationalRecord(data) {
      return (
          isManager() &&
          (
            !isRestrictedItsmData(data) ||
            isExplicitlyAuthorizedForRestricted(data)
          )
        ) ||
        (
          isItsmSelfServiceRole() &&
          isPrincipalWorkItemOwner(data) &&
          isSelfServiceVisible(data) &&
          !isRestrictedItsmData(data)
        );
    }

    function canReadRestrictedItsmRecord(data) {
      return isManager() && isExplicitlyAuthorizedForRestricted(data);
    }

    function isSharedItsmWorkItemCollection(collectionName) {
      return collectionName in ['serviceRequests', 'changeRequests'];
    }

    function isRestrictedItsmWorkItemCollection(collectionName) {
      return collectionName in ['securityFindings', 'securityExceptions'];
    }

    function canReadItsmSubresourceParent(collectionName, workItemId) {
      let parent = get(
        /databases/$(database)/documents/$(collectionName)/$(workItemId)
      ).data;
      return (
          isSharedItsmWorkItemCollection(collectionName) &&
          canReadItsmOperationalRecord(parent)
        ) ||
        (
          isRestrictedItsmWorkItemCollection(collectionName) &&
          canReadRestrictedItsmRecord(parent)
        );
    }

    function validSelfServiceRequestCreate() {
      return isItsmSelfServiceRole() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status in ['draft', 'submitted', 'open'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        !isRestrictedItsmData(request.resource.data) &&
        !request.resource.data.keys().hasAny([
          'approvalState',
          'approvals',
          'assignedGroupId',
          'assignedUserId',
          'audit',
          'closedAt',
          'slaState'
        ]);
    }

    function isPublishedConfiguration(data) {
      return (
          data.keys().hasAny(['status']) &&
          data.status in ['PUBLISHED', 'published']
        ) ||
        (
          data.keys().hasAny(['state']) &&
          data.state in ['PUBLISHED', 'published']
        );
    }

    function canReadItsmConfiguration(data) {
      return isManager() ||
        ((isAdmin() || isUser()) && isPublishedConfiguration(data));
    }

    function canReadItsmCatalogueItem(data) {
      return isManager() ||
        (
          (isUser() || isAdmin()) &&
          isPublishedConfiguration(data) &&
          (
            !data.keys().hasAny(['isActive']) ||
            data.isActive == true
          )
        );
    }

    function isEmployeeKnowledge(data) {
      return isPublishedConfiguration(data) &&
        (
          !data.keys().hasAny(['visibility']) ||
          data.visibility in [
            'EMPLOYEE',
            'employee',
            'EMPLOYEES',
            'employees',
            'ALL',
            'all'
          ]
        );
    }

    function canReadKnowledgeArticle(data) {
      return isManager() ||
        ((isUser() || isAdmin()) && isEmployeeKnowledge(data));
    }

    function protectedKnowledgeFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'feedbackCount',
        'helpfulCount',
        'notHelpfulCount',
        'lastFeedbackAt',
        'lastViewedAt',
        'usageCount',
        'viewCount'
      ]);
    }

    function validManagerKnowledgeCreate() {
      return isManager() &&
        request.resource.data.state in [
          'DRAFT',
          'draft',
          'REVIEW',
          'review',
          'PUBLISHED',
          'published'
        ] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          !request.resource.data.keys().hasAny(['viewCount']) ||
          request.resource.data.viewCount == 0
        ) &&
        (
          !request.resource.data.keys().hasAny(['feedbackCount']) ||
          request.resource.data.feedbackCount == 0
        );
    }

    function validManagerKnowledgeUpdate() {
      return isManager() &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.state in [
          'DRAFT',
          'draft',
          'REVIEW',
          'review',
          'PUBLISHED',
          'published',
          'RETIRED',
          'retired',
          'ARCHIVED',
          'archived'
        ] &&
        protectedKnowledgeFieldsUnchanged();
    }

    function validManagerDraftCreate() {
      return isManager() &&
        request.resource.data.status in ['DRAFT', 'draft'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validManagerDraftUpdate() {
      return isManager() &&
        resource.data.status in ['DRAFT', 'draft'] &&
        request.resource.data.status in ['DRAFT', 'draft'] &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    function canReadItsmReportSnapshot(data) {
      return !isRestrictedItsmData(data) &&
        (
          (
            isManager() &&
            data.keys().hasAny(['audience']) &&
            data.audience in ['MANAGER', 'manager', 'ALL', 'all']
          ) ||
          (
            isAdmin() &&
            data.keys().hasAny(['audience']) &&
            data.audience in ['ADMIN', 'admin', 'ALL', 'all']
          )
        );
    }

    function canReadItsmAuditEvent(data) {
      return (isManager() || isAdmin()) &&
        (
          !isRestrictedItsmData(data) ||
          isExplicitlyAuthorizedForRestricted(data)
        );
    }

    function newsRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['news'])
        ? permissions.news
        : (
          permissions.keys().hasAny(['communication'])
            ? permissions.communication
            : (
              permissions.keys().hasAny(['feed'])
                ? permissions.feed
                : 'NONE'
            )
        );
    }

    function isNewsManager() {
      return newsRole() == 'MANAGER';
    }

    function isNewsReviewer() {
      return newsRole() == 'REVIEWER';
    }

    function userManagementRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['usermanagement'])
        ? permissions.usermanagement
        : (
          permissions.keys().hasAny(['user_management'])
            ? permissions.user_management
            : 'NONE'
        );
    }

    function canReadUserManagement() {
      return userManagementRole() in ['USER', 'MANAGER', 'ADMIN'];
    }

    function canManageUserManagement() {
      return userManagementRole() == 'MANAGER';
    }

    function taskRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['tasks'])
        ? permissions.tasks
        : (
          permissions.keys().hasAny(['task'])
            ? permissions.task
            : 'NONE'
        );
    }

    function isTaskUser() {
      return taskRole() in ['USER', 'user', 'User'];
    }

    function isTaskManager() {
      return taskRole() in ['MANAGER', 'manager', 'Manager'];
    }

    function isTaskAdmin() {
      return taskRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function canManageTasks() {
      return isTaskUser() || isTaskManager();
    }

    function principalDepartmentId() {
      let data = principalData();
      return data.keys().hasAny(['departmentId']) &&
        data.departmentId is string &&
        data.departmentId != ''
          ? data.departmentId
          : (
            data.keys().hasAny(['department']) &&
            data.department is string &&
            data.department != ''
              ? data.department
              : (
                data.keys().hasAny(['direction']) &&
                data.direction is string
                  ? data.direction
                  : ''
              )
          );
    }

    function canReadTask(task) {
      return isTaskAdmin() ||
        (
          canManageTasks() &&
          principalDepartmentId() != '' &&
          task.department == principalDepartmentId()
        );
    }

    function validTaskCreate() {
      return signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        request.resource.data.keys().hasAll([
          'label',
          'observation',
          'creation_date',
          'updated_at',
          'status',
          'type',
          'department',
          'created_by_user_id',
          'created_by_email'
        ]) &&
        request.resource.data.label is string &&
        request.resource.data.label.size() > 0 &&
        request.resource.data.observation is string &&
        request.resource.data.status in ['new', 'doing', 'done', 'archived'] &&
        request.resource.data.type in ['task', 'mail'] &&
        request.resource.data.department == principalDepartmentId() &&
        request.resource.data.creation_date == request.time &&
        request.resource.data.updated_at == request.time &&
        (
          request.resource.data.created_by_user_id == request.auth.uid ||
          request.resource.data.created_by_email == request.auth.token.email
        ) &&
        (
          request.resource.data.type != 'mail' ||
          (
            request.resource.data.sender is string &&
            request.resource.data.sender.size() > 0 &&
            request.resource.data.receiver is string &&
            request.resource.data.receiver.size() > 0
          )
        );
    }

    function validTaskUpdate() {
      return signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        resource.data.department == principalDepartmentId() &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.department_name == resource.data.department_name &&
        request.resource.data.creation_date == resource.data.creation_date &&
        request.resource.data.created_by_user_id == resource.data.created_by_user_id &&
        request.resource.data.created_by_name == resource.data.created_by_name &&
        request.resource.data.created_by_email == resource.data.created_by_email &&
        request.resource.data.label is string &&
        request.resource.data.label.size() > 0 &&
        request.resource.data.observation is string &&
        request.resource.data.status in ['new', 'doing', 'done', 'archived'] &&
        request.resource.data.type in ['task', 'mail'] &&
        request.resource.data.updated_at == request.time &&
        (
          request.resource.data.type != 'mail' ||
          (
            request.resource.data.sender is string &&
            request.resource.data.sender.size() > 0 &&
            request.resource.data.receiver is string &&
            request.resource.data.receiver.size() > 0
          )
        );
    }

    function meetingHallRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['meetinghall'])
        ? permissions.meetinghall
        : (
          permissions.keys().hasAny(['meeting_hall'])
            ? permissions.meeting_hall
            : (
              permissions.keys().hasAny(['meeting-hall'])
                ? permissions['meeting-hall']
                : (
                  permissions.keys().hasAny(['meeting'])
                    ? permissions.meeting
                    : 'NONE'
                )
            )
        );
    }

    function isMeetingHallUser() {
      return meetingHallRole() == 'USER';
    }

    function isMeetingHallManager() {
      return meetingHallRole() == 'MANAGER';
    }

    function isMeetingHallAdmin() {
      return meetingHallRole() == 'ADMIN';
    }

    function hasMeetingHallAccess() {
      return isMeetingHallUser() || isMeetingHallManager() || isMeetingHallAdmin();
    }

    function isMeetingHallReservationOwner(reservation) {
      return signedIn() &&
        (
          reservation.userId == request.auth.uid ||
          reservation.userEmail == request.auth.token.email ||
          (
            reservation.userId is string &&
            reservation.userId.size() > 0 &&
            agentEmailMatches(reservation.userId)
          )
        );
    }

    function validMeetingHallReservationCreate() {
      return signedIn() &&
        (isMeetingHallUser() || isMeetingHallManager()) &&
        request.resource.data.hallId is string &&
        request.resource.data.hallId.size() > 0 &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        (
          (
            request.resource.data.status == 'ON_HOLD' &&
            isMeetingHallReservationOwner(request.resource.data)
          ) ||
          (
            request.resource.data.status == 'BLOCKED' &&
            isMeetingHallManager()
          )
        ) &&
        request.resource.data.startTime is timestamp &&
        request.resource.data.endTime is timestamp &&
        request.resource.data.endTime > request.resource.data.startTime &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validMeetingHallReservationStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() &&
        isMeetingHallManager() &&
        changed.hasOnly(['status', 'updatedAt', 'rejectionReason', 'cancelReason']) &&
        request.resource.data.status in ['ON_HOLD', 'ACCEPTED', 'REJECTED', 'CANCELLED', 'BLOCKED'] &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.status != 'REJECTED' ||
          (
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0
          )
        );
    }

    function validMeetingHallData() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() > 0 &&
        request.resource.data.capacity is int &&
        request.resource.data.capacity > 0;
    }

    function validNotificationEventCreate() {
      return signedIn() &&
        request.resource.data.keys().hasAll([
          'eventType',
          'moduleKey',
          'title',
          'body',
          'entityType',
          'entityId',
          'route',
          'createdByUserId',
          'createdByName',
          'createdByEmail',
          'target',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.target is map &&
        request.resource.data.target.type in ['ALL', 'MODULE_ROLE', 'USERS'] &&
        (
          request.resource.data.createdByUserId == request.auth.uid ||
          request.resource.data.createdByEmail == request.auth.token.email ||
          (
            request.resource.data.createdByUserId is string &&
            request.resource.data.createdByUserId.size() > 0 &&
            agentEmailMatches(request.resource.data.createdByUserId)
          )
        );
    }

    function isTicketOwner(ticket) {
      return signedIn() &&
        (ticket.createdByUserId == request.auth.uid ||
         ticket.affectedUserId == request.auth.uid ||
         ticket.createdByEmail == request.auth.token.email ||
         ticket.affectedUserEmail == request.auth.token.email);
    }

    function canReadTicket(ticket) {
      return (isManager() && ticket.lifecycleState in ['active', 'closed']) ||
        (isItsmSelfServiceRole() && isTicketOwner(ticket));
    }

    function validUserCreate() {
      return isItsmSelfServiceRole() &&
        request.resource.data.status == 'open' &&
        request.resource.data.lifecycleState == 'active' &&
        (request.resource.data.createdByUserId == request.auth.uid ||
         request.resource.data.createdByEmail == request.auth.token.email) &&
        (request.resource.data.affectedUserId == request.auth.uid ||
         request.resource.data.affectedUserEmail == request.auth.token.email) &&
        request.resource.data.createdByEmail == request.resource.data.affectedUserEmail &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.isDeleted == false &&
        request.resource.data.assignedToUserId == '' &&
        request.resource.data.categoryId == '' &&
        request.resource.data.impact == '' &&
        request.resource.data.urgency == '' &&
        request.resource.data.priority == '';
    }

    function validManagerCreate() {
      return isManager() &&
        request.resource.data.status in ['open', 'in_progress'] &&
        request.resource.data.lifecycleState == 'active' &&
        (request.resource.data.createdByUserId == request.auth.uid ||
         request.resource.data.createdByEmail == request.auth.token.email) &&
        request.resource.data.affectedUserId is string &&
        request.resource.data.affectedUserId != '' &&
        request.resource.data.affectedUserEmail is string &&
        request.resource.data.affectedUserEmail != '' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.isDeleted == false &&
        request.resource.data.assignedToUserId == '' &&
        (
          (
            request.resource.data.status == 'open' &&
            request.resource.data.categoryId == '' &&
            request.resource.data.impact == '' &&
            request.resource.data.urgency == '' &&
            request.resource.data.priority == ''
          ) ||
          (
            request.resource.data.status == 'in_progress' &&
            request.resource.data.categoryId is string &&
            request.resource.data.categoryId != '' &&
            request.resource.data.impact in ['low', 'medium', 'high'] &&
            request.resource.data.urgency in ['low', 'medium', 'high'] &&
            request.resource.data.priority in ['P1', 'P2', 'P3', 'P4']
          )
        );
    }

    function managerUpdateKeys() {
      return [
        'categoryId',
        'categoryName',
        'subcategoryId',
        'subcategoryName',
        'affectedServiceId',
        'affectedServiceName',
        'location',
        'deviceType',
        'assetId',
        'configurationItemId',
        'relatedServiceRequestId',
        'relatedChangeId',
        'suggestedKnowledgeArticleIds',
        'userImpactDescription',
        'impact',
        'urgency',
        'priority',
        'assignedToUserId',
        'assignedToName',
        'assignedToEmail',
        'status',
        'lifecycleState',
        'resolutionSummary',
        'resolutionCode',
        'closedByUserId',
        'closedByName',
        'closedAt',
        'archiveEligibleAt',
        'updatedAt',
        'lastCommentAt',
        'lastStatusChangedAt',
        'commentCount',
        'attachmentCount'
      ];
    }

    function validManagerUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isManager() &&
        resource.data.lifecycleState in ['active', 'closed'] &&
        request.resource.data.lifecycleState in ['active', 'closed'] &&
        request.resource.data.status != 'archived' &&
        request.resource.data.isDeleted == resource.data.isDeleted &&
        request.resource.data.archivedAt == resource.data.archivedAt &&
        changed.hasOnly(managerUpdateKeys()) &&
        request.resource.data.updatedAt == request.time;
    }

    match /tasks/{taskId} {
      allow get, list: if signedIn() && canReadTask(resource.data);
      allow create: if validTaskCreate();
      allow update: if validTaskUpdate();
      allow delete: if signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        resource.data.department == principalDepartmentId();
    }

    match /incidentTickets/{ticketId} {
      allow get, list: if signedIn() && canReadTicket(resource.data);
      allow create: if validUserCreate() || validManagerCreate();
      allow update: if validManagerUpdate();
      allow delete: if false;

      match /comments/{commentId} {
        allow get, list: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          (!resource.data.isInternal || isManager());

        allow create: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          (request.resource.data.createdByUserId == request.auth.uid ||
           request.resource.data.createdByEmail == request.auth.token.email) &&
          request.resource.data.createdAt == request.time &&
          (
            (isItsmSelfServiceRole() &&
             request.resource.data.isInternal == false) ||
            (isManager() && request.resource.data.isInternal == true)
          );

        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data);

        allow create: if signedIn() &&
          canReadTicket(getAfter(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          request.resource.data.uploadedByUserId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          (isItsmSelfServiceRole() || isManager());

        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow get, list: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data);

        allow create: if signedIn() &&
          canReadTicket(getAfter(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          (request.resource.data.actorUserId == request.auth.uid ||
           request.resource.data.actorEmail == request.auth.token.email) &&
          request.resource.data.createdAt == request.time &&
          (isItsmSelfServiceRole() || isManager());

        allow update, delete: if false;
      }
    }

    match /incidentCategories/{categoryId} {
      allow get, list: if signedIn() && hasIncidentAccess();
      allow create, update: if signedIn() && isManager();
      allow delete: if false;
    }

    match /itServices/{serviceId} {
      allow get, list: if signedIn() && hasIncidentAccess();
      allow create, update: if signedIn() && isManager();
      allow delete: if false;
    }

    match /incidentResolutionCodes/{resolutionCodeId} {
      allow get, list: if signedIn() && hasIncidentAccess();
      allow create, update: if signedIn() && isManager();
      allow delete: if false;
    }

    match /itsmWorkItemIndex/{workItemId} {
      allow get, list: if signedIn() &&
        canReadItsmOperationalRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /itsmReportSnapshots/{snapshotId} {
      allow get, list: if signedIn() &&
        canReadItsmReportSnapshot(resource.data);
      allow create, update, delete: if false;
    }

    match /itsmAuditEvents/{eventId} {
      allow get, list: if signedIn() &&
        canReadItsmAuditEvent(resource.data);
      allow create, update, delete: if false;
    }

    match /serviceCatalogItems/{catalogItemId} {
      allow get, list: if signedIn() &&
        canReadItsmCatalogueItem(resource.data);
      allow create, update, delete: if false;
    }

    match /knowledgeCategories/{categoryId} {
      allow get, list: if signedIn() &&
        (
          isManager() ||
          (
            (isUser() || isAdmin()) &&
            resource.data.isActive == true
          )
        );
      allow create, update, delete: if false;
    }

    match /knowledgeArticles/{articleId} {
      allow get, list: if signedIn() &&
        canReadKnowledgeArticle(resource.data);
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get, list: if signedIn() &&
          canReadKnowledgeArticle(
            get(
              /databases/$(database)/documents/knowledgeArticles/$(articleId)
            ).data
          ) &&
          (
            isManager() ||
            resource.data.state in ['PUBLISHED', 'published']
          );
        allow create, update, delete: if false;

        match /attachments/{attachmentId} {
          allow get, list: if signedIn() &&
            canReadKnowledgeArticle(
              get(
                /databases/$(database)/documents/knowledgeArticles/$(articleId)
              ).data
            ) &&
            (
              isManager() ||
              (
                resource.data.isInternal == false &&
                isPublishedConfiguration(
                  get(
                    /databases/$(database)/documents/knowledgeArticles/$(articleId)/versions/$(versionId)
                  ).data
                )
              )
            );
          allow create, update, delete: if false;
        }
      }

      match /feedback/{feedbackId} {
        allow get: if signedIn() &&
          (
            isManager() ||
            (
              feedbackId == request.auth.uid &&
              canReadKnowledgeArticle(
                get(
                  /databases/$(database)/documents/knowledgeArticles/$(articleId)
                ).data
              )
            )
          );
        allow list: if isManager();
        allow create, update, delete: if false;
      }

      match /views/{viewId} {
        allow get, list: if isManager();
        allow create, update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadKnowledgeArticle(
            get(
              /databases/$(database)/documents/knowledgeArticles/$(articleId)
            ).data
          ) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );
        allow create, update, delete: if false;
      }
    }

    match /workflowDefinitions/{workflowDefinitionId} {
      allow get, list: if signedIn() &&
        canReadItsmConfiguration(resource.data);
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get, list: if signedIn() &&
          canReadItsmConfiguration(resource.data);
        allow create, update, delete: if false;
      }
    }

    match /slaPolicies/{slaPolicyId} {
      allow get, list: if signedIn() &&
        canReadItsmConfiguration(resource.data);
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get, list: if signedIn() &&
          canReadItsmConfiguration(resource.data);
        allow create, update, delete: if false;
      }
    }

    match /{workItemCollection}/{workItemId} {
      allow get, list: if signedIn() &&
        isSharedItsmWorkItemCollection(workItemCollection) &&
        canReadItsmOperationalRecord(resource.data);
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );

        allow create: if signedIn() &&
          !isAdmin() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          request.resource.data.createdByUserId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.isInternal is bool &&
          (
            isManager() ||
            (
              isItsmSelfServiceRole() &&
              isPrincipalWorkItemOwner(
                get(
                  /databases/$(database)/documents/$(workItemCollection)/$(workItemId)
                ).data
              ) &&
              request.resource.data.isInternal == false
            )
          );

        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );

        allow create, update, delete: if false;
      }

      match /auditLogs/{auditLogId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );
        allow create, update, delete: if false;
      }

      match /tasks/{taskId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId);
        allow create, update, delete: if false;
      }

      match /workflowInstances/{workflowInstanceId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId);
        allow create, update, delete: if false;
      }
    }

    match /securityFindings/{findingId} {
      allow get, list: if signedIn() &&
        canReadRestrictedItsmRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /securityExceptions/{exceptionId} {
      allow get, list: if signedIn() &&
        canReadRestrictedItsmRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /meeting_halls/{hallId} {
      allow get, list: if signedIn() && hasMeetingHallAccess();
      allow create: if signedIn() &&
        isMeetingHallManager() &&
        validMeetingHallData() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if signedIn() &&
        isMeetingHallManager() &&
        validMeetingHallData() &&
        request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && isMeetingHallManager();
    }

    match /meeting_hall_reservations/{reservationId} {
      allow get, list: if signedIn() && hasMeetingHallAccess();
      allow create: if validMeetingHallReservationCreate();
      allow update: if validMeetingHallReservationStatusUpdate();
      allow delete: if false;
    }

    match /newsPosts/{postId} {
      allow get, list: if signedIn() &&
        (resource.data.status == 'PUBLISHED' || isNewsManager() || isNewsReviewer());

      allow create: if signedIn() &&
        isNewsManager() &&
        request.resource.data.status == 'DRAFT' &&
        (request.resource.data.authorId == request.auth.uid ||
         request.resource.data.authorEmail == request.auth.token.email) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if signedIn() &&
        (
          (
            isNewsManager() &&
            (resource.data.authorId == request.auth.uid ||
             resource.data.authorEmail == request.auth.token.email) &&
            (
              (
                request.resource.data.status in ['DRAFT', 'PENDING'] &&
                resource.data.status in ['DRAFT', 'REJECTED']
              ) ||
              (
                resource.data.status == 'ACCEPTED' &&
                request.resource.data.status == 'PUBLISHED'
              ) ||
              (
                resource.data.status == 'PUBLISHED' &&
                request.resource.data.status == 'ARCHIVED'
              )
            )
          ) ||
          (
            isNewsReviewer() &&
            resource.data.status == 'PENDING' &&
            request.resource.data.status in ['ACCEPTED', 'REJECTED'] &&
            (request.resource.data.reviewedByUserId == request.auth.uid ||
             request.resource.data.reviewedByEmail == request.auth.token.email)
          )
        );

      allow delete: if false;
    }

    match /notificationEvents/{eventId} {
      allow create: if validNotificationEventCreate();
      allow get, list, update, delete: if false;
    }

    match /globalNotifications/{notificationId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /departments/{departmentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && canManageUserManagement();
    }

    match /directions/{directionId} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && canManageUserManagement();
    }

    match /services/{serviceId} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && canManageUserManagement();
    }

    match /bureaux/{bureauId} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && canManageUserManagement();
    }

    match /modules/{moduleId} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && canManageUserManagement();
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || canReadUserManagement());
      allow list: if signedIn() && canReadUserManagement();
      allow create, update, delete: if false;
    }

    match /agents/{agentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && canManageUserManagement();

      match /deviceTokens/{tokenId} {
        allow get, list: if isSelfAgent(agentId);
        allow create, update: if isSelfAgent(agentId) &&
          request.resource.data.agentId == agentId &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isSelfAgent(agentId);
      }

      match /notifications/{notificationId} {
        allow get, list: if isSelfAgent(agentId);
        allow create: if false;
        allow update: if isSelfAgent(agentId) &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isRead', 'readAt']) &&
              request.resource.data.isRead == true &&
              request.resource.data.readAt == request.time
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isRead', 'readAt', 'isCleared', 'clearedAt']) &&
              request.resource.data.isRead == true &&
              request.resource.data.readAt == request.time &&
              request.resource.data.isCleared == true &&
              request.resource.data.clearedAt == request.time
            )
          );
        allow delete: if false;
      }

      match /notificationReads/{notificationId} {
        allow get, list: if isSelfAgent(agentId);
        allow create, update: if isSelfAgent(agentId) &&
          request.resource.data.keys().hasOnly([
            'notificationId',
            'isRead',
            'readAt',
            'isCleared',
            'clearedAt'
          ]) &&
          request.resource.data.notificationId == notificationId &&
          request.resource.data.isRead == true &&
          request.resource.data.readAt == request.time &&
          (
            !request.resource.data.keys().hasAny(['isCleared', 'clearedAt']) ||
            (
              request.resource.data.isCleared == true &&
              request.resource.data.clearedAt == request.time
            )
          );
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
