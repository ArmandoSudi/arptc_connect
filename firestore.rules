rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authAgentPath() {
      return /databases/$(database)/documents/agents/$(request.auth.uid);
    }

    function hasAuthAgentDocument() {
      return signedIn() && exists(authAgentPath());
    }

    function hasVerifiedAuthEmail() {
      return signedIn() &&
        (
          !request.auth.token.keys().hasAny(['email_verified']) ||
          request.auth.token.email_verified == true
        );
    }

    function hasActiveAuthAgentDocument() {
      return hasVerifiedAuthEmail() &&
        hasAuthAgentDocument() &&
        get(authAgentPath()).data.keys().hasAny(['isActive']) &&
        get(authAgentPath()).data.isActive == true &&
        (
          !get(authAgentPath()).data.keys().hasAny(['mustChangePassword']) ||
          get(authAgentPath()).data.mustChangePassword != true
        );
    }

    function isSelfAgent(agentId) {
      return hasActiveAuthAgentDocument() && agentId == request.auth.uid;
    }

    function principalData() {
      return hasActiveAuthAgentDocument()
        ? get(authAgentPath()).data
        : {};
    }

    function isUser() {
      return hasActiveAuthAgentDocument() &&
        itsmRole() in ['USER', 'user', 'User'];
    }

    function isManager() {
      return hasActiveAuthAgentDocument() &&
        itsmRole() in ['MANAGER', 'manager', 'Manager'];
    }

    function isAdmin() {
      return hasActiveAuthAgentDocument() &&
        itsmRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function hasIncidentAccess() {
      return isUser() || isManager() || isAdmin();
    }

    function itsmRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['ticketing'])
        ? permissions.ticketing
        : (
          permissions.keys().hasAny(['itsm'])
            ? permissions.itsm
            : (
              permissions.keys().hasAny(['it_service_management'])
                ? permissions.it_service_management
                : (
                  permissions.keys().hasAny(['itservicemanagement'])
                    ? permissions.itservicemanagement
                    : (
                      permissions.keys().hasAny(['support'])
                        ? permissions.support
                        : (
                          permissions.keys().hasAny(['incident'])
                            ? permissions.incident
                            : (
                              permissions.keys().hasAny(['incidents'])
                                ? permissions.incidents
                                : (
                                  permissions.keys().hasAny(['incident_management'])
                                    ? permissions.incident_management
                                    : (
                                      permissions.keys().hasAny(['incidentmanagement'])
                                        ? permissions.incidentmanagement
                                        : (
                                          permissions.keys().hasAny(['ticket'])
                                            ? permissions.ticket
                                            : (
                                              permissions.keys().hasAny(['tickets'])
                                                ? permissions.tickets
                                                : (
                                                  data.keys().hasAny(['incidentRole']) &&
                                                  data.incidentRole is string &&
                                                  data.incidentRole != ''
                                                    ? data.incidentRole
                                                    : 'NONE'
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        );
    }

    function isItsmSelfServiceRole() {
      return isUser() || isAdmin();
    }

    function isRestrictedItsmData(data) {
      return (
          data.keys().hasAny(['confidentiality']) &&
          data.confidentiality in [
            'RESTRICTED',
            'restricted',
            'SECURITY_RESTRICTED',
            'security_restricted',
            'CONFIDENTIAL',
            'confidential'
          ]
        ) ||
        (
          data.keys().hasAny(['isRestricted']) &&
          data.isRestricted == true
        );
    }

    function isExplicitlyAuthorizedForRestricted(data) {
      return signedIn() &&
        (
          (
            data.keys().hasAny(['authorizedUserIds']) &&
            data.authorizedUserIds is list &&
            request.auth.uid in data.authorizedUserIds
          ) ||
          (
            data.keys().hasAny(['authorizedManagerIds']) &&
            data.authorizedManagerIds is list &&
            request.auth.uid in data.authorizedManagerIds
          ) ||
          (
            data.keys().hasAny(['assignedUserId']) &&
            data.assignedUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requesterId']) &&
            data.requesterId == request.auth.uid
          )
        );
    }

    function isPrincipalWorkItemOwner(data) {
      return signedIn() &&
        (
          (
            data.keys().hasAny(['requesterId']) &&
            data.requesterId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requesterEmail']) &&
            data.requesterEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['requestedForUserId']) &&
            data.requestedForUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requestedForEmail']) &&
            data.requestedForEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['createdByUserId']) &&
            data.createdByUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['createdByEmail']) &&
            data.createdByEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['affectedUserId']) &&
            data.affectedUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['affectedUserEmail']) &&
            data.affectedUserEmail == request.auth.token.email
          )
        );
    }

    function isSelfServiceVisible(data) {
      return !data.keys().hasAny(['selfServiceVisible']) ||
        data.selfServiceVisible == true;
    }

    function canReadItsmOperationalRecord(data) {
      return (
          isManager() &&
          (
            !isRestrictedItsmData(data) ||
            isExplicitlyAuthorizedForRestricted(data)
          )
        ) ||
        (
          isItsmSelfServiceRole() &&
          isPrincipalWorkItemOwner(data) &&
          isSelfServiceVisible(data) &&
          !isRestrictedItsmData(data)
        );
    }

    function canReadRestrictedItsmRecord(data) {
      return isManager() && isExplicitlyAuthorizedForRestricted(data);
    }

    function isBoundedSecurityComplianceQuery() {
      return request.query.limit != null && request.query.limit <= 101;
    }

    function isBoundedItsmAdministrationQuery() {
      return request.query.limit != null && request.query.limit <= 101;
    }

    function isSecurityFindingAuthorized(data) {
      return isManager();
    }

    function isManagerAuthorizedForRestrictedSecurityData(data) {
      return isManager() &&
        (
          !isRestrictedItsmData(data) ||
          isExplicitlyAuthorizedForRestricted(data) ||
          (
            data.keys().hasAny(['owner']) &&
            data.owner is map &&
            data.owner.keys().hasAny(['userId']) &&
            data.owner.userId == request.auth.uid
          )
        );
    }

    function isSecurityExceptionRequester(data) {
      return signedIn() &&
        data.keys().hasAny(['requester']) &&
        data.requester is map &&
        data.requester.keys().hasAny(['userId']) &&
        data.requester.userId == request.auth.uid;
    }

    function canReadSecurityException(data) {
      return isManager() ||
        (
          isItsmSelfServiceRole() &&
          isSecurityExceptionRequester(data) &&
          isSelfServiceVisible(data)
        );
    }

    function isOwnAccessReviewItem(data) {
      return signedIn() &&
        data.keys().hasAny(['subjectUser']) &&
        data.subjectUser is map &&
        data.subjectUser.keys().hasAny(['userId']) &&
        data.subjectUser.userId == request.auth.uid;
    }

    function canReadAccessReviewItem(data) {
      return isManager() ||
        (
          isItsmSelfServiceRole() &&
          isOwnAccessReviewItem(data) &&
          isSelfServiceVisible(data)
        );
    }

    function canReadAccessCorrectionRequest(data) {
      return isManager() ||
        (
          isItsmSelfServiceRole() &&
          data.keys().hasAny(['requestedBy']) &&
          data.requestedBy == request.auth.uid
        );
    }

    function canReadSecurityEvidence(parentData, evidenceData) {
      return isManager() &&
        (
          !isRestrictedItsmData(parentData) ||
          isManagerAuthorizedForRestrictedSecurityData(parentData)
        ) &&
        (
          !isRestrictedItsmData(evidenceData) ||
          (
            evidenceData.keys().hasAny(['authorizedManagerIds']) &&
            evidenceData.authorizedManagerIds is list &&
            request.auth.uid in evidenceData.authorizedManagerIds
          )
        );
    }

    function isRequesterVisibleSecurityChild(data) {
      return data.keys().hasAny(['requesterVisible']) &&
        data.requesterVisible == true &&
        data.keys().hasAny(['isInternal']) &&
        data.isInternal == false &&
        data.keys().hasAny(['confidentiality']) &&
        data.confidentiality in ['INTERNAL', 'internal'];
    }

    function canReadSecurityExceptionChild(exceptionId, childData) {
      let parent = get(
        /databases/$(database)/documents/securityExceptions/$(exceptionId)
      ).data;
      return (
          isManager() &&
          (
            !isRestrictedItsmData(parent) ||
            isExplicitlyAuthorizedForRestricted(parent)
          ) &&
          (
            !isRestrictedItsmData(childData) ||
            (
              childData.keys().hasAny(['authorizedManagerIds']) &&
              childData.authorizedManagerIds is list &&
              request.auth.uid in childData.authorizedManagerIds
            )
          )
        ) ||
        (
          isItsmSelfServiceRole() &&
          isSecurityExceptionRequester(parent) &&
          isRequesterVisibleSecurityChild(childData)
        );
    }

    function isSharedItsmWorkItemCollection(collectionName) {
      return collectionName == 'serviceRequests';
    }

    function isChangeRequester(data) {
      return signedIn() &&
        data.keys().hasAny(['requesterId']) &&
        data.requesterId == request.auth.uid;
    }

    function canReadChangeRequest(data) {
      return isManager() ||
        (
          isItsmSelfServiceRole() &&
          isChangeRequester(data)
        );
    }

    function canReadChangeParent(changeId) {
      return canReadChangeRequest(
        get(
          /databases/$(database)/documents/changeRequests/$(changeId)
        ).data
      );
    }

    function canReadChangePublicSubresource(changeId, data) {
      return canReadChangeParent(changeId) &&
        (
          isManager() ||
          (
            (!data.keys().hasAny(['isInternal']) || data.isInternal == false) &&
            (!data.keys().hasAny(['selfServiceVisible']) ||
              data.selfServiceVisible == true)
          )
        );
    }

    function isPublishedChangeCalendarEntry(data) {
      return data.keys().hasAny(['publishMaintenance']) &&
        data.publishMaintenance == true;
    }

    function canReadChangeCalendarEntry(data) {
      return isManager() ||
        (
          isUser() &&
          (
            isPublishedChangeCalendarEntry(data) ||
            (
              data.keys().hasAny(['requesterId']) &&
              data.requesterId == request.auth.uid
            )
          )
        ) ||
        (isAdmin() && isPublishedChangeCalendarEntry(data));
    }

    function canReadItsmSubresourceParent(collectionName, workItemId) {
      let parent = get(
        /databases/$(database)/documents/$(collectionName)/$(workItemId)
      ).data;
      return isSharedItsmWorkItemCollection(collectionName) &&
        canReadItsmOperationalRecord(parent);
    }

    function validSelfServiceRequestCreate() {
      return isItsmSelfServiceRole() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status in ['draft', 'submitted', 'open'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        !isRestrictedItsmData(request.resource.data) &&
        !request.resource.data.keys().hasAny([
          'approvalState',
          'approvals',
          'assignedGroupId',
          'assignedUserId',
          'audit',
          'closedAt',
          'slaState'
        ]);
    }

    function isPublishedConfiguration(data) {
      return (
          data.keys().hasAny(['status']) &&
          data.status in ['PUBLISHED', 'published']
        ) ||
        (
          data.keys().hasAny(['state']) &&
          data.state in ['PUBLISHED', 'published']
        );
    }

    function isRetiredConfiguration(data) {
      return (
          data.keys().hasAny(['status']) &&
          data.status in ['RETIRED', 'retired']
        ) ||
        (
          data.keys().hasAny(['state']) &&
          data.state in ['RETIRED', 'retired']
        );
    }

    function isPublishedOrRetiredConfiguration(data) {
      return isPublishedConfiguration(data) || isRetiredConfiguration(data);
    }

    function canReadItsmConfigurationParent(data) {
      return isManager() ||
        (isAdmin() && isPublishedOrRetiredConfiguration(data)) ||
        (isUser() && isPublishedConfiguration(data));
    }

    function canReadItsmConfigurationVersion(data) {
      return isManager() ||
        (isAdmin() && isPublishedOrRetiredConfiguration(data)) ||
        (isUser() && isPublishedConfiguration(data));
    }

    function canReadItsmCatalogueItem(data) {
      return isManager() ||
        (
          (isUser() || isAdmin()) &&
          isPublishedConfiguration(data) &&
          (
            !data.keys().hasAny(['isActive']) ||
            data.isActive == true
          )
        );
    }

    function isEmployeeKnowledge(data) {
      return isPublishedConfiguration(data) &&
        (
          !data.keys().hasAny(['visibility']) ||
          data.visibility in [
            'EMPLOYEE',
            'employee',
            'EMPLOYEES',
            'employees',
            'ALL',
            'all'
          ]
        );
    }

    function canReadKnowledgeArticle(data) {
      return isManager() ||
        ((isUser() || isAdmin()) && isEmployeeKnowledge(data));
    }

    function protectedKnowledgeFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'feedbackCount',
        'helpfulCount',
        'notHelpfulCount',
        'lastFeedbackAt',
        'lastViewedAt',
        'usageCount',
        'viewCount'
      ]);
    }

    function validManagerKnowledgeCreate() {
      return isManager() &&
        request.resource.data.state in [
          'DRAFT',
          'draft',
          'REVIEW',
          'review',
          'PUBLISHED',
          'published'
        ] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          !request.resource.data.keys().hasAny(['viewCount']) ||
          request.resource.data.viewCount == 0
        ) &&
        (
          !request.resource.data.keys().hasAny(['feedbackCount']) ||
          request.resource.data.feedbackCount == 0
        );
    }

    function validManagerKnowledgeUpdate() {
      return isManager() &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.state in [
          'DRAFT',
          'draft',
          'REVIEW',
          'review',
          'PUBLISHED',
          'published',
          'RETIRED',
          'retired',
          'ARCHIVED',
          'archived'
        ] &&
        protectedKnowledgeFieldsUnchanged();
    }

    function validManagerDraftCreate() {
      return isManager() &&
        request.resource.data.status in ['DRAFT', 'draft'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validManagerDraftUpdate() {
      return isManager() &&
        resource.data.status in ['DRAFT', 'draft'] &&
        request.resource.data.status in ['DRAFT', 'draft'] &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    function canReadItsmReportSnapshot(data) {
      return !isRestrictedItsmData(data) &&
        (
          (
            isManager() &&
            data.keys().hasAny(['audience']) &&
            data.audience in ['MANAGER', 'manager']
          ) ||
          (
            isAdmin() &&
            data.keys().hasAny(['audience']) &&
            data.audience in ['ADMIN', 'admin']
          )
        );
    }

    function isManagerExplicitlyAuthorizedForAudit(data) {
      return isManager() &&
        (
          (
            data.keys().hasAny(['authorizedManagerIds']) &&
            data.authorizedManagerIds is list &&
            request.auth.uid in data.authorizedManagerIds
          ) ||
          (
            data.keys().hasAny(['authorizedUserIds']) &&
            data.authorizedUserIds is list &&
            request.auth.uid in data.authorizedUserIds
          )
        );
    }

    function canGetItsmAuditEvent(data) {
      return (
          isManager() &&
          (
            !isRestrictedItsmData(data) ||
            isManagerExplicitlyAuthorizedForAudit(data)
          )
        ) ||
        (isAdmin() && !isRestrictedItsmData(data));
    }

    function canListItsmAuditEvent(data) {
      return (
          isManager() &&
          (
            data.isRestricted == false ||
            (
              data.isRestricted == true &&
              request.auth.uid in data.authorizedManagerIds
            )
          )
        ) ||
        (isAdmin() && data.isRestricted == false);
    }

    function canReadItsmSlaState(data) {
      return (
          isManager() &&
          (
            !isRestrictedItsmData(data) ||
            isExplicitlyAuthorizedForRestricted(data)
          )
        ) ||
        (
          isItsmSelfServiceRole() &&
          isPrincipalWorkItemOwner(data) &&
          isSelfServiceVisible(data) &&
          !isRestrictedItsmData(data)
        );
    }

    function canReadItsmReferenceData(data) {
      return isManager() ||
        (
          (isAdmin() || isUser()) &&
          !isRestrictedItsmData(data) &&
          isPublishedConfiguration(data)
        );
    }

    function canReadItsmAuditExport(data) {
      return (isManager() || isAdmin()) &&
        data.keys().hasAll([
          'requesterUserId',
          'status',
          'expiresAt'
        ]) &&
        data.requesterUserId == request.auth.uid &&
        data.status in ['COMPLETED', 'completed'] &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time;
    }

    function canReadAssetSelfServiceProjection(data) {
      return isManager() ||
        (
          isItsmSelfServiceRole() &&
          data.keys().hasAll(['assignedUserId', 'isCurrent']) &&
          data.assignedUserId == request.auth.uid &&
          data.isCurrent == true
        );
    }

    function canReadAssetAssignment(data) {
      return isManager() ||
        (
          isItsmSelfServiceRole() &&
          data.keys().hasAny(['assignedUserId']) &&
          data.assignedUserId == request.auth.uid &&
          (
            (
              data.keys().hasAny(['isCurrent']) &&
              data.isCurrent == true
            ) ||
            (
              data.keys().hasAny(['status']) &&
              data.status in ['current', 'CURRENT']
            )
          )
        );
    }

    function newsRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['news'])
        ? permissions.news
        : (
          permissions.keys().hasAny(['communication'])
            ? permissions.communication
            : (
              permissions.keys().hasAny(['feed'])
                ? permissions.feed
                : 'NONE'
            )
        );
    }

    function isNewsManager() {
      return newsRole() == 'MANAGER';
    }

    function isNewsReviewer() {
      return newsRole() == 'REVIEWER';
    }

    function userManagementRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['usermanagement'])
        ? permissions.usermanagement
        : (
          permissions.keys().hasAny(['user_management'])
            ? permissions.user_management
            : 'NONE'
        );
    }

    function canReadUserManagement() {
      return userManagementRole() in ['USER', 'MANAGER', 'ADMIN'];
    }

    function canManageUserManagement() {
      return userManagementRole() == 'MANAGER';
    }

    // Organization data is available only after the identity and agent profile
    // are both verified. This intentionally does not reuse the legacy
    // email-verification fallback used by unrelated modules.
    function hasActiveVerifiedOrganizationPrincipal() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['email_verified']) &&
        request.auth.token.email_verified == true &&
        hasAuthAgentDocument() &&
        get(authAgentPath()).data.keys().hasAny(['isActive']) &&
        get(authAgentPath()).data.isActive == true &&
        (
          !get(authAgentPath()).data.keys().hasAny(['mustChangePassword']) ||
          get(authAgentPath()).data.mustChangePassword != true
        );
    }

    function principalOrganizationId() {
      let data = hasActiveVerifiedOrganizationPrincipal()
        ? get(authAgentPath()).data
        : {};
      return data.keys().hasAny(['organizationId']) &&
        data.organizationId is string
          ? data.organizationId
          : '';
    }

    function isUserManagementSupervisor() {
      return hasActiveVerifiedOrganizationPrincipal() &&
        userManagementRole() in [
          'MANAGER',
          'manager',
          'Manager',
          'ADMIN',
          'admin',
          'Admin'
        ];
    }

    function isBoundedOrganizationQuery() {
      return request.query.limit != null && request.query.limit <= 100;
    }

    function inventoryRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['inventory'])
        ? permissions.inventory
        : (
          permissions.keys().hasAny(['inventaire'])
            ? permissions.inventaire
            : 'NONE'
        );
    }

    function isInventoryUser() {
      return inventoryRole() in ['USER', 'user', 'User'];
    }

    function isInventoryManager() {
      return inventoryRole() in ['MANAGER', 'manager', 'Manager'];
    }

    function isInventoryAdmin() {
      return inventoryRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function hasInventoryAccess() {
      return hasActiveAuthAgentDocument() &&
        (isInventoryUser() || isInventoryManager() || isInventoryAdmin());
    }

    function isBoundedInventoryQuery() {
      return request.query.limit != null && request.query.limit <= 100;
    }

    function isInventoryRequestOwner(data) {
      return signedIn() &&
        data.keys().hasAny(['requestedFor']) &&
        data.requestedFor is map &&
        data.requestedFor.keys().hasAny(['userId']) &&
        data.requestedFor.userId == request.auth.uid;
    }

    function canReadMaterialRequest(data) {
      return isInventoryManager() ||
        isInventoryAdmin() ||
        (isInventoryUser() && isInventoryRequestOwner(data));
    }

    function canReadMaterialRequestParent(requestId) {
      return canReadMaterialRequest(
        get(
          /databases/$(database)/documents/materialRequests/$(requestId)
        ).data
      );
    }

    function canReadInventoryCatalogueItem(data) {
      return hasInventoryAccess() &&
        data.keys().hasAll(['isActive', 'isRequestable']) &&
        data.isActive == true &&
        data.isRequestable == true;
    }

    function isSamePrincipalOrganization(data) {
      return hasActiveVerifiedOrganizationPrincipal() &&
        principalOrganizationId() != '' &&
        data.keys().hasAny(['organizationId']) &&
        data.organizationId == principalOrganizationId();
    }

    function canReadPrivateAgent(data) {
      return isUserManagementSupervisor();
    }

    function canReadAgentDirectoryRecord(data) {
      return isUserManagementSupervisor() ||
        (
          isSamePrincipalOrganization(data) &&
          data.keys().hasAny(['isActive']) &&
          data.isActive == true
        );
    }

    function canReadOrganizationAssignment(data) {
      return hasActiveVerifiedOrganizationPrincipal() &&
        (
          (
            data.keys().hasAny(['agentId']) &&
            data.agentId == request.auth.uid
          ) ||
          isUserManagementSupervisor()
        );
    }

    function canReadOrganizationAuditEvent(data) {
      return isUserManagementSupervisor();
    }

    function taskRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['tasks'])
        ? permissions.tasks
        : (
          permissions.keys().hasAny(['task'])
            ? permissions.task
            : 'NONE'
        );
    }

    function isTaskUser() {
      return taskRole() in ['USER', 'user', 'User'];
    }

    function isTaskManager() {
      return taskRole() in ['MANAGER', 'manager', 'Manager'];
    }

    function isTaskAdmin() {
      return taskRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function canManageTasks() {
      return isTaskUser() || isTaskManager();
    }

    function principalDepartmentId() {
      let data = principalData();
      return data.keys().hasAny(['departmentId']) &&
        data.departmentId is string &&
        data.departmentId != ''
          ? data.departmentId
          : '';
    }

    function canReadTask(task) {
      return isTaskAdmin() ||
        (
          canManageTasks() &&
          principalDepartmentId() != '' &&
          task.department == principalDepartmentId()
        );
    }

    function validTaskCreate() {
      return signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        request.resource.data.keys().hasAll([
          'label',
          'observation',
          'creation_date',
          'updated_at',
          'status',
          'type',
          'department',
          'created_by_user_id',
          'created_by_email'
        ]) &&
        request.resource.data.label is string &&
        request.resource.data.label.size() > 0 &&
        request.resource.data.observation is string &&
        request.resource.data.status in ['new', 'doing', 'done', 'archived'] &&
        request.resource.data.type in ['task', 'mail'] &&
        request.resource.data.department == principalDepartmentId() &&
        request.resource.data.creation_date == request.time &&
        request.resource.data.updated_at == request.time &&
        (
          request.resource.data.created_by_user_id == request.auth.uid ||
          request.resource.data.created_by_email == request.auth.token.email
        ) &&
        (
          request.resource.data.type != 'mail' ||
          (
            request.resource.data.sender is string &&
            request.resource.data.sender.size() > 0 &&
            request.resource.data.receiver is string &&
            request.resource.data.receiver.size() > 0
          )
        );
    }

    function validTaskUpdate() {
      return signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        resource.data.department == principalDepartmentId() &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.department_name == resource.data.department_name &&
        request.resource.data.creation_date == resource.data.creation_date &&
        request.resource.data.created_by_user_id == resource.data.created_by_user_id &&
        request.resource.data.created_by_name == resource.data.created_by_name &&
        request.resource.data.created_by_email == resource.data.created_by_email &&
        request.resource.data.label is string &&
        request.resource.data.label.size() > 0 &&
        request.resource.data.observation is string &&
        request.resource.data.status in ['new', 'doing', 'done', 'archived'] &&
        request.resource.data.type in ['task', 'mail'] &&
        request.resource.data.updated_at == request.time &&
        (
          request.resource.data.type != 'mail' ||
          (
            request.resource.data.sender is string &&
            request.resource.data.sender.size() > 0 &&
            request.resource.data.receiver is string &&
            request.resource.data.receiver.size() > 0
          )
        );
    }

    function meetingHallRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['meetinghall'])
        ? permissions.meetinghall
        : (
          permissions.keys().hasAny(['meeting_hall'])
            ? permissions.meeting_hall
            : (
              permissions.keys().hasAny(['meeting-hall'])
                ? permissions['meeting-hall']
                : (
                  permissions.keys().hasAny(['meeting'])
                    ? permissions.meeting
                    : 'NONE'
                )
            )
        );
    }

    function isMeetingHallUser() {
      return meetingHallRole() == 'USER';
    }

    function isMeetingHallManager() {
      return meetingHallRole() == 'MANAGER';
    }

    function isMeetingHallAdmin() {
      return meetingHallRole() == 'ADMIN';
    }

    function hasMeetingHallAccess() {
      return isMeetingHallUser() || isMeetingHallManager() || isMeetingHallAdmin();
    }

    function isMeetingHallReservationOwner(reservation) {
      return signedIn() &&
        (
          reservation.userId == request.auth.uid ||
          reservation.userEmail == request.auth.token.email
        );
    }

    function validMeetingHallReservationCreate() {
      return signedIn() &&
        (isMeetingHallUser() || isMeetingHallManager()) &&
        request.resource.data.hallId is string &&
        request.resource.data.hallId.size() > 0 &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        (
          (
            request.resource.data.status == 'ON_HOLD' &&
            isMeetingHallReservationOwner(request.resource.data)
          ) ||
          (
            request.resource.data.status == 'BLOCKED' &&
            isMeetingHallManager()
          )
        ) &&
        request.resource.data.startTime is timestamp &&
        request.resource.data.endTime is timestamp &&
        request.resource.data.endTime > request.resource.data.startTime &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validMeetingHallReservationStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() &&
        isMeetingHallManager() &&
        changed.hasOnly([
          'status',
          'updatedAt',
          'rejectionReason',
          'cancelReason',
          'lastActionByUserId',
          'lastActionByName',
          'lastActionByEmail'
        ]) &&
        request.resource.data.lastActionByUserId == request.auth.uid &&
        request.resource.data.lastActionByEmail == request.auth.token.email &&
        request.resource.data.status in ['ON_HOLD', 'ACCEPTED', 'REJECTED', 'CANCELLED', 'BLOCKED'] &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.status != 'REJECTED' ||
          (
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0
          )
        );
    }

    function validMeetingHallData() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() > 0 &&
        request.resource.data.capacity is int &&
        request.resource.data.capacity > 0;
    }

    function isTicketOwner(ticket) {
      return signedIn() &&
        (ticket.createdByUserId == request.auth.uid ||
         ticket.affectedUserId == request.auth.uid ||
         ticket.createdByEmail == request.auth.token.email ||
         ticket.affectedUserEmail == request.auth.token.email);
    }

    function canReadTicket(ticket) {
      return (isManager() && ticket.lifecycleState in ['active', 'closed']) ||
        (isItsmSelfServiceRole() && isTicketOwner(ticket));
    }

    function validUserCreate() {
      return isItsmSelfServiceRole() &&
        request.resource.data.status == 'open' &&
        request.resource.data.lifecycleState == 'active' &&
        request.resource.data.createdByRole in ['USER', 'ADMIN'] &&
        (request.resource.data.createdByUserId == request.auth.uid ||
         request.resource.data.createdByEmail == request.auth.token.email) &&
        (request.resource.data.affectedUserId == request.auth.uid ||
         request.resource.data.affectedUserEmail == request.auth.token.email) &&
        request.resource.data.createdByEmail == request.resource.data.affectedUserEmail &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.isDeleted == false &&
        request.resource.data.assignedToUserId == '' &&
        request.resource.data.categoryId == '' &&
        request.resource.data.impact == '' &&
        request.resource.data.urgency == '' &&
        request.resource.data.priority == '';
    }

    function validManagerCreate() {
      return isManager() &&
        request.resource.data.status in ['open', 'in_progress'] &&
        request.resource.data.lifecycleState == 'active' &&
        request.resource.data.createdByRole == 'MANAGER' &&
        (request.resource.data.createdByUserId == request.auth.uid ||
         request.resource.data.createdByEmail == request.auth.token.email) &&
        request.resource.data.affectedUserId is string &&
        request.resource.data.affectedUserId != '' &&
        request.resource.data.affectedUserEmail is string &&
        request.resource.data.affectedUserEmail != '' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.isDeleted == false &&
        request.resource.data.assignedToUserId == '' &&
        (
          (
            request.resource.data.status == 'open' &&
            request.resource.data.categoryId == '' &&
            request.resource.data.impact == '' &&
            request.resource.data.urgency == '' &&
            request.resource.data.priority == ''
          ) ||
          (
            request.resource.data.status == 'in_progress' &&
            request.resource.data.categoryId is string &&
            request.resource.data.categoryId != '' &&
            request.resource.data.impact in ['low', 'medium', 'high'] &&
            request.resource.data.urgency in ['low', 'medium', 'high'] &&
            request.resource.data.priority in ['P1', 'P2', 'P3', 'P4']
          )
        );
    }

    function managerUpdateKeys() {
      return [
        'categoryId',
        'categoryName',
        'subcategoryId',
        'subcategoryName',
        'affectedServiceId',
        'affectedServiceName',
        'location',
        'deviceType',
        'assetId',
        'configurationItemId',
        'relatedServiceRequestId',
        'relatedChangeId',
        'suggestedKnowledgeArticleIds',
        'userImpactDescription',
        'impact',
        'urgency',
        'priority',
        'assignedToUserId',
        'assignedToName',
        'assignedToEmail',
        'status',
        'lifecycleState',
        'resolutionSummary',
        'resolutionCode',
        'closedByUserId',
        'closedByName',
        'closedAt',
        'archiveEligibleAt',
        'updatedAt',
        'lastCommentAt',
        'lastStatusChangedAt',
        'commentCount',
        'attachmentCount',
        'lastActionByUserId',
        'lastActionByName',
        'lastActionByEmail'
      ];
    }

    function validManagerUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isManager() &&
        resource.data.lifecycleState in ['active', 'closed'] &&
        request.resource.data.lifecycleState in ['active', 'closed'] &&
        request.resource.data.status != 'archived' &&
        request.resource.data.isDeleted == resource.data.isDeleted &&
        request.resource.data.archivedAt == resource.data.archivedAt &&
        changed.hasOnly(managerUpdateKeys()) &&
        request.resource.data.updatedAt == request.time;
    }

    match /tasks/{taskId} {
      allow get, list: if signedIn() && canReadTask(resource.data);
      allow create: if validTaskCreate();
      allow update: if validTaskUpdate();
      allow delete: if signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        resource.data.department == principalDepartmentId();
    }

    match /incidentTickets/{ticketId} {
      allow get, list: if signedIn() && canReadTicket(resource.data);
      allow create: if validUserCreate() || validManagerCreate();
      allow update: if validManagerUpdate();
      allow delete: if false;

      match /comments/{commentId} {
        allow get, list: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          (!resource.data.isInternal || isManager());

        allow create: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          (request.resource.data.createdByUserId == request.auth.uid ||
           request.resource.data.createdByEmail == request.auth.token.email) &&
          request.resource.data.createdAt == request.time &&
          (
            (isItsmSelfServiceRole() &&
             request.resource.data.isInternal == false) ||
            (isManager() && request.resource.data.isInternal == true)
          );

        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data);

        allow create: if signedIn() &&
          canReadTicket(getAfter(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          request.resource.data.uploadedByUserId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          (isItsmSelfServiceRole() || isManager());

        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow get, list: if signedIn() &&
          canReadTicket(get(/databases/$(database)/documents/incidentTickets/$(ticketId)).data);

        allow create: if signedIn() &&
          canReadTicket(getAfter(/databases/$(database)/documents/incidentTickets/$(ticketId)).data) &&
          (request.resource.data.actorUserId == request.auth.uid ||
           request.resource.data.actorEmail == request.auth.token.email) &&
          request.resource.data.createdAt == request.time &&
          (isItsmSelfServiceRole() || isManager());

        allow update, delete: if false;
      }
    }

    match /incidentCategories/{categoryId} {
      allow get, list: if signedIn() && hasIncidentAccess();
      allow create, update: if signedIn() && isManager();
      allow delete: if false;
    }

    match /itServices/{serviceId} {
      allow get, list: if signedIn() && hasIncidentAccess();
      allow create, update: if signedIn() && isManager();
      allow delete: if false;
    }

    match /incidentResolutionCodes/{resolutionCodeId} {
      allow get, list: if signedIn() && hasIncidentAccess();
      allow create, update: if signedIn() && isManager();
      allow delete: if false;
    }

    match /assets/{assetId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }

      match /photographs/{photographId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }
    }

    // Server-owned uniqueness locks for asset serial numbers.
    match /assetIdentifierLocks/{lockId} {
      allow read, write: if false;
    }

    match /assetSelfServiceProjections/{projectionId} {
      allow get, list: if signedIn() &&
        canReadAssetSelfServiceProjection(resource.data);
      allow create, update, delete: if false;
    }

    match /assetModels/{modelId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /assetParameters/{parameterId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /assetAssignments/{assignmentId} {
      allow get, list: if signedIn() &&
        canReadAssetAssignment(resource.data);
      allow create, update, delete: if false;
    }

    match /assetLifecycleEvents/{eventId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /assetStateEvents/{eventId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /stockLocations/{locationId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /stockItems/{stockItemId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /stockSupportingDocuments/{attachmentId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /softwareLicences/{licenceId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;

      match /allocations/{allocationId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }

      match /history/{eventId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }
    }

    match /suppliers/{supplierId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;

      match /contacts/{contactId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }
    }

    match /supplierContracts/{contractId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }
    }

    match /warranties/{warrantyId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;

      match /claims/{claimId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;

        match /history/{eventId} {
          allow get, list: if signedIn() && isManager();
          allow create, update, delete: if false;
        }
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }
    }

    match /configurationItems/{configurationItemId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;

      match /history/{eventId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }
    }

    match /ciRelationships/{relationshipId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /itsmWorkItemIndex/{workItemId} {
      allow get, list: if signedIn() &&
        canReadItsmOperationalRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /itsmReportSnapshots/{snapshotId} {
      allow get: if signedIn() && canReadItsmReportSnapshot(resource.data);
      allow list: if signedIn() &&
        canReadItsmReportSnapshot(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;

      match /shards/{shardId} {
        allow read, write: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /itsmReportContributions/{contributionId} {
      allow read, write: if false;
    }

    match /itsmAuditEvents/{eventId} {
      allow get: if signedIn() && canGetItsmAuditEvent(resource.data);
      allow list: if signedIn() &&
        canListItsmAuditEvent(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;
    }

    match /itsmAuditExports/{exportId} {
      allow get: if signedIn() && canReadItsmAuditExport(resource.data);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /serviceCatalogItems/{catalogItemId} {
      allow get: if signedIn() && canReadItsmCatalogueItem(resource.data);
      allow list: if signedIn() &&
        canReadItsmCatalogueItem(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get: if signedIn() &&
          canReadItsmConfigurationVersion(resource.data);
        allow list: if signedIn() &&
          canReadItsmConfigurationVersion(resource.data) &&
          isBoundedItsmAdministrationQuery();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /knowledgeCategories/{categoryId} {
      allow get, list: if signedIn() &&
        (
          isManager() ||
          (
            (isUser() || isAdmin()) &&
            resource.data.isActive == true
          )
        );
      allow create, update, delete: if false;
    }

    match /knowledgeArticles/{articleId} {
      allow get, list: if signedIn() &&
        canReadKnowledgeArticle(resource.data);
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get, list: if signedIn() &&
          canReadKnowledgeArticle(
            get(
              /databases/$(database)/documents/knowledgeArticles/$(articleId)
            ).data
          ) &&
          (
            isManager() ||
            resource.data.state in ['PUBLISHED', 'published']
          );
        allow create, update, delete: if false;

        match /attachments/{attachmentId} {
          allow get, list: if signedIn() &&
            canReadKnowledgeArticle(
              get(
                /databases/$(database)/documents/knowledgeArticles/$(articleId)
              ).data
            ) &&
            (
              isManager() ||
              (
                resource.data.isInternal == false &&
                isPublishedConfiguration(
                  get(
                    /databases/$(database)/documents/knowledgeArticles/$(articleId)/versions/$(versionId)
                  ).data
                )
              )
            );
          allow create, update, delete: if false;
        }
      }

      match /feedback/{feedbackId} {
        allow get: if signedIn() &&
          (
            isManager() ||
            (
              feedbackId == request.auth.uid &&
              canReadKnowledgeArticle(
                get(
                  /databases/$(database)/documents/knowledgeArticles/$(articleId)
                ).data
              )
            )
          );
        allow list: if isManager();
        allow create, update, delete: if false;
      }

      match /views/{viewId} {
        allow get, list: if isManager();
        allow create, update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadKnowledgeArticle(
            get(
              /databases/$(database)/documents/knowledgeArticles/$(articleId)
            ).data
          ) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );
        allow create, update, delete: if false;
      }
    }

    match /workflowDefinitions/{workflowDefinitionId} {
      allow get: if signedIn() &&
        canReadItsmConfigurationParent(resource.data);
      allow list: if signedIn() &&
        canReadItsmConfigurationParent(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get: if signedIn() &&
          canReadItsmConfigurationVersion(resource.data);
        allow list: if signedIn() &&
          canReadItsmConfigurationVersion(resource.data) &&
          isBoundedItsmAdministrationQuery();
        allow create, update, delete: if false;
      }
    }

    match /slaPolicies/{slaPolicyId} {
      allow get: if signedIn() &&
        canReadItsmConfigurationParent(resource.data);
      allow list: if signedIn() &&
        canReadItsmConfigurationParent(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get: if signedIn() &&
          canReadItsmConfigurationVersion(resource.data);
        allow list: if signedIn() &&
          canReadItsmConfigurationVersion(resource.data) &&
          isBoundedItsmAdministrationQuery();
        allow create, update, delete: if false;
      }
    }

    match /itsmSlaStates/{slaStateId} {
      allow get: if signedIn() && canReadItsmSlaState(resource.data);
      allow list: if signedIn() &&
        canReadItsmSlaState(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;
    }

    match /itsmReferenceData/{referenceId} {
      allow get: if signedIn() && canReadItsmReferenceData(resource.data);
      allow list: if signedIn() &&
        canReadItsmReferenceData(resource.data) &&
        isBoundedItsmAdministrationQuery();
      allow create, update, delete: if false;
    }

    match /changeRequests/{changeId} {
      allow get, list: if signedIn() && canReadChangeRequest(resource.data);
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if signedIn() &&
          canReadChangePublicSubresource(changeId, resource.data);
        allow create, update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadChangePublicSubresource(changeId, resource.data);
        allow create, update, delete: if false;
      }

      match /auditLogs/{auditLogId} {
        allow get, list: if signedIn() &&
          canReadChangePublicSubresource(changeId, resource.data);
        allow create, update, delete: if false;
      }

      match /tasks/{taskId} {
        allow get, list: if signedIn() &&
          canReadChangePublicSubresource(changeId, resource.data);
        allow create, update, delete: if false;
      }

      // Approval records and their immutable history are private CAB
      // deliberations. Requesters consume only trusted summary fields on the
      // parent change request.
      match /approvals/{approvalId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;

        match /history/{historyId} {
          allow get, list: if signedIn() && isManager();
          allow create, update, delete: if false;
        }
      }

      match /approvalHistory/{historyId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }

      match /cabMeetings/{meetingId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }

      match /workflowInstances/{workflowInstanceId} {
        allow get, list: if signedIn() && isManager();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /changeCalendarEntries/{changeId} {
      allow get, list: if signedIn() &&
        canReadChangeCalendarEntry(resource.data);
      allow create, update, delete: if false;
    }

    match /changeApprovalGroups/{groupId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /maintenanceWindows/{windowId} {
      allow get, list: if signedIn() && isManager();
      allow create, update, delete: if false;
    }

    match /{workItemCollection}/{workItemId} {
      allow get, list: if signedIn() &&
        isSharedItsmWorkItemCollection(workItemCollection) &&
        canReadItsmOperationalRecord(resource.data);
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );

        allow create: if signedIn() &&
          !isAdmin() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          request.resource.data.createdByUserId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.isInternal is bool &&
          (
            isManager() ||
            (
              isItsmSelfServiceRole() &&
              isPrincipalWorkItemOwner(
                get(
                  /databases/$(database)/documents/$(workItemCollection)/$(workItemId)
                ).data
              ) &&
              request.resource.data.isInternal == false
            )
          );

        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );

        allow create, update, delete: if false;
      }

      match /auditLogs/{auditLogId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );
        allow create, update, delete: if false;
      }

      match /tasks/{taskId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId) &&
          (
            !resource.data.keys().hasAny(['isInternal']) ||
            resource.data.isInternal == false ||
            isManager()
          );
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId);
        allow create, update, delete: if false;
      }

      match /workflowInstances/{workflowInstanceId} {
        allow get, list: if signedIn() &&
          canReadItsmSubresourceParent(workItemCollection, workItemId);
        allow create, update, delete: if false;
      }
    }

    match /securityFindings/{findingId} {
      allow get: if signedIn() && isSecurityFindingAuthorized(resource.data);
      allow list: if signedIn() &&
        isSecurityFindingAuthorized(resource.data) &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;

      match /attachments/{attachmentId} {
        allow get: if signedIn() &&
          canReadSecurityEvidence(
            get(
              /databases/$(database)/documents/securityFindings/$(findingId)
            ).data,
            resource.data
          );
        allow list: if signedIn() &&
          canReadSecurityEvidence(
            get(
              /databases/$(database)/documents/securityFindings/$(findingId)
            ).data,
            resource.data
          ) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{governedCollection}/{recordId} {
        allow get: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'comments',
            'remediationLinks',
            'validationHistory'
          ] &&
          isSecurityFindingAuthorized(
            get(
              /databases/$(database)/documents/securityFindings/$(findingId)
            ).data
          );
        allow list: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'comments',
            'remediationLinks',
            'validationHistory'
          ] &&
          isSecurityFindingAuthorized(
            get(
              /databases/$(database)/documents/securityFindings/$(findingId)
            ).data
          ) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /securityExceptions/{exceptionId} {
      allow get: if signedIn() && canReadSecurityException(resource.data);
      allow list: if signedIn() &&
        canReadSecurityException(resource.data) &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get: if signedIn() &&
          canReadSecurityExceptionChild(exceptionId, resource.data);
        allow list: if signedIn() &&
          canReadSecurityExceptionChild(exceptionId, resource.data) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow get: if signedIn() &&
          canReadSecurityExceptionChild(exceptionId, resource.data);
        allow list: if signedIn() &&
          canReadSecurityExceptionChild(exceptionId, resource.data) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        allow get: if signedIn() &&
          isManager() &&
          (
            !isRestrictedItsmData(
              get(
                /databases/$(database)/documents/securityExceptions/$(exceptionId)
              ).data
            ) ||
            isExplicitlyAuthorizedForRestricted(
              get(
                /databases/$(database)/documents/securityExceptions/$(exceptionId)
              ).data
            )
          );
        allow list: if signedIn() &&
          isManager() &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;

        match /history/{historyId} {
          allow get: if signedIn() && isManager();
          allow list: if signedIn() &&
            isManager() &&
            isBoundedSecurityComplianceQuery();
          allow create, update, delete: if false;
        }
      }

      match /{governedCollection}/{recordId} {
        allow get: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'renewalRequests',
            'reviewHistory'
          ] &&
          canReadSecurityExceptionChild(exceptionId, resource.data);
        allow list: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'renewalRequests',
            'reviewHistory'
          ] &&
          canReadSecurityExceptionChild(exceptionId, resource.data) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /assetComplianceAssessments/{assessmentId} {
      allow get: if signedIn() && isManager();
      allow list: if signedIn() &&
        isManager() &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;

      match /attachments/{attachmentId} {
        allow get: if signedIn() &&
          canReadSecurityEvidence(
            get(
              /databases/$(database)/documents/assetComplianceAssessments/$(assessmentId)
            ).data,
            resource.data
          );
        allow list: if signedIn() &&
          canReadSecurityEvidence(
            get(
              /databases/$(database)/documents/assetComplianceAssessments/$(assessmentId)
            ).data,
            resource.data
          ) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{governedCollection}/{recordId} {
        allow get: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'comments',
            'remediationLinks'
          ] &&
          isManager();
        allow list: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'comments',
            'remediationLinks'
          ] &&
          isManager() &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /assetComplianceSelfService/{projectionId} {
      allow get: if signedIn() &&
        (
          isManager() ||
          (
            isUser() &&
            resource.data.assignedUserId == request.auth.uid
          )
        );
      allow list: if signedIn() &&
        (
          isManager() ||
          (
            isUser() &&
            resource.data.assignedUserId == request.auth.uid
          )
        ) &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /accessReviewCampaigns/{campaignId} {
      allow get: if signedIn() && isManager();
      allow list: if signedIn() &&
        isManager() &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;

      match /{governedCollection}/{recordId} {
        allow get: if signedIn() &&
          governedCollection in ['auditLogs', 'decisionHistory'] &&
          isManager();
        allow list: if signedIn() &&
          governedCollection in ['auditLogs', 'decisionHistory'] &&
          isManager() &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /accessReviewItems/{itemId} {
      allow get: if signedIn() && canReadAccessReviewItem(resource.data);
      allow list: if signedIn() &&
        canReadAccessReviewItem(resource.data) &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;

      match /attachments/{attachmentId} {
        allow get: if signedIn() &&
          canReadSecurityEvidence(
            get(
              /databases/$(database)/documents/accessReviewItems/$(itemId)
            ).data,
            resource.data
          );
        allow list: if signedIn() &&
          canReadSecurityEvidence(
            get(
              /databases/$(database)/documents/accessReviewItems/$(itemId)
            ).data,
            resource.data
          ) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /correctionRequests/{requestId} {
        allow get: if signedIn() &&
          canReadAccessCorrectionRequest(resource.data);
        allow list: if signedIn() &&
          canReadAccessCorrectionRequest(resource.data) &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{governedCollection}/{recordId} {
        allow get: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'comments',
            'decisionHistory',
            'revocationTasks'
          ] &&
          isManager();
        allow list: if signedIn() &&
          governedCollection in [
            'auditLogs',
            'comments',
            'decisionHistory',
            'revocationTasks'
          ] &&
          isManager() &&
          isBoundedSecurityComplianceQuery();
        allow create, update, delete: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /{correctionPath=**}/correctionRequests/{requestId} {
      allow get: if signedIn() &&
        canReadAccessCorrectionRequest(resource.data);
      allow list: if signedIn() &&
        canReadAccessCorrectionRequest(resource.data) &&
        isBoundedSecurityComplianceQuery();
      allow create, update, delete: if false;
    }

    match /inventoryCatalogProjections/{itemId} {
      allow get: if canReadInventoryCatalogueItem(resource.data);
      allow list: if canReadInventoryCatalogueItem(resource.data) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryItems/{itemId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryWarehouses/{warehouseId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryLocations/{locationId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryParameters/{parameterId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryBalances/{balanceId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryStockMovements/{movementId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /materialRequests/{requestId} {
      allow get: if canReadMaterialRequest(resource.data);
      allow list: if canReadMaterialRequest(resource.data) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;

      match /{childCollection}/{childId} {
        allow get: if childCollection in ['lines', 'allocations', 'auditLogs'] &&
          canReadMaterialRequestParent(requestId);
        allow list: if childCollection in ['lines', 'allocations', 'auditLogs'] &&
          canReadMaterialRequestParent(requestId) &&
          isBoundedInventoryQuery();
        allow create, update, delete: if false;
      }
    }

    match /inventoryAlerts/{alertId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryAuditEvents/{eventId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if (isInventoryManager() || isInventoryAdmin()) &&
        isBoundedInventoryQuery();
      allow create, update, delete: if false;
    }

    match /inventoryDashboardSnapshots/{snapshotId} {
      allow get: if isInventoryManager() || isInventoryAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /inventorySupportingDocuments/{documentId} {
      allow get: if resource.data.keys().hasAny(['requestId']) &&
        canReadMaterialRequestParent(resource.data.requestId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /inventoryCommandReceipts/{commandId} {
      allow read, write: if false;
    }

    match /inventoryItemSkuLocks/{sku} {
      allow read, write: if false;
    }

    match /meeting_halls/{hallId} {
      allow get, list: if signedIn() && hasMeetingHallAccess();
      allow create: if signedIn() &&
        isMeetingHallManager() &&
        validMeetingHallData() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if signedIn() &&
        isMeetingHallManager() &&
        validMeetingHallData() &&
        request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && isMeetingHallManager();
    }

    match /meeting_hall_reservations/{reservationId} {
      allow get, list: if signedIn() && hasMeetingHallAccess();
      allow create: if validMeetingHallReservationCreate();
      allow update: if validMeetingHallReservationStatusUpdate();
      allow delete: if false;
    }

    match /newsPosts/{postId} {
      allow get, list: if signedIn() &&
        (resource.data.status == 'PUBLISHED' || isNewsManager() || isNewsReviewer());

      allow create: if signedIn() &&
        isNewsManager() &&
        request.resource.data.status == 'DRAFT' &&
        (request.resource.data.authorId == request.auth.uid ||
         request.resource.data.authorEmail == request.auth.token.email) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if signedIn() &&
        (
          (
            isNewsManager() &&
            (resource.data.authorId == request.auth.uid ||
             resource.data.authorEmail == request.auth.token.email) &&
            (
              (
                request.resource.data.status in ['DRAFT', 'PENDING'] &&
                resource.data.status in ['DRAFT', 'REJECTED']
              ) ||
              (
                resource.data.status == 'ACCEPTED' &&
                request.resource.data.status == 'PUBLISHED'
              ) ||
              (
                resource.data.status == 'PUBLISHED' &&
                request.resource.data.status == 'ARCHIVED'
              )
            )
          ) ||
          (
            isNewsReviewer() &&
            resource.data.status == 'PENDING' &&
            request.resource.data.status in ['ACCEPTED', 'REJECTED'] &&
            (request.resource.data.reviewedByUserId == request.auth.uid ||
             request.resource.data.reviewedByEmail == request.auth.token.email)
          )
        );

      allow delete: if false;
    }

    match /notificationEvents/{eventId} {
      // Events are created by trusted Functions after the source mutation.
      allow read, write: if false;
    }

    match /globalNotifications/{notificationId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /departments/{departmentId} {
      allow read, write: if false;
    }

    match /directions/{directionId} {
      allow read, write: if false;
    }

    match /services/{serviceId} {
      allow read, write: if false;
    }

    match /bureaux/{bureauId} {
      allow read, write: if false;
    }

    match /organizations/{organizationId} {
      allow get: if isUserManagementSupervisor();
      allow list: if isUserManagementSupervisor() &&
        isBoundedOrganizationQuery();
      allow create, update, delete: if false;
    }

    match /organizationDirectory/{organizationId} {
      allow get: if isUserManagementSupervisor() ||
        (
          hasActiveVerifiedOrganizationPrincipal() &&
          organizationId == principalOrganizationId() &&
          resource.data.status == 'ACTIVE'
        );
      allow list: if (
          isUserManagementSupervisor() ||
          (
            hasActiveVerifiedOrganizationPrincipal() &&
            organizationId == principalOrganizationId() &&
            resource.data.status == 'ACTIVE'
          )
        ) && isBoundedOrganizationQuery();
      allow create, update, delete: if false;
    }

    match /organizationUnits/{unitId} {
      allow get: if isUserManagementSupervisor();
      allow list: if isUserManagementSupervisor() &&
        isBoundedOrganizationQuery();
      allow create, update, delete: if false;
    }

    match /organizationAssignments/{assignmentId} {
      allow get: if canReadOrganizationAssignment(resource.data);
      allow list: if canReadOrganizationAssignment(resource.data) &&
        isBoundedOrganizationQuery();
      allow create, update, delete: if false;
    }

    match /agentDirectory/{agentId} {
      allow get: if canReadAgentDirectoryRecord(resource.data);
      allow list: if canReadAgentDirectoryRecord(resource.data) &&
        isBoundedOrganizationQuery();
      allow create, update, delete: if false;
    }

    match /organizationAuditEvents/{eventId} {
      allow get: if canReadOrganizationAuditEvent(resource.data);
      allow list: if canReadOrganizationAuditEvent(resource.data) &&
        isBoundedOrganizationQuery();
      allow create, update, delete: if false;
    }

    match /agentAuthorizationIndex/{agentId} {
      allow read, write: if false;
    }

    match /organizationCodeLocks/{code} {
      allow read, write: if false;
    }

    match /organizationUnitCodeLocks/{code} {
      allow read, write: if false;
    }

    match /organizationCommandReceipts/{commandId} {
      allow read, write: if false;
    }

    match /modules/{moduleId} {
      allow get, list: if isUserManagementSupervisor();
      allow create, update, delete: if signedIn() && canManageUserManagement();
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || canReadUserManagement());
      allow list: if signedIn() && canReadUserManagement();
      allow create, update, delete: if false;
    }

    match /agents/{agentId} {
      allow get: if (
          signedIn() &&
          request.auth.token.keys().hasAny(['email_verified']) &&
          request.auth.token.email_verified == true &&
          agentId == request.auth.uid
        ) || canReadPrivateAgent(resource.data);
      allow list: if canReadPrivateAgent(resource.data) &&
        isBoundedOrganizationQuery();
      // Parent profiles are provisioned and maintained only by trusted account
      // Functions so the document ID always remains the Firebase Auth UID.
      allow create, update, delete: if false;

      match /deviceTokens/{tokenId} {
        allow get, list: if isSelfAgent(agentId);
        allow create, update: if isSelfAgent(agentId) &&
          request.resource.data.agentId == agentId &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isSelfAgent(agentId);
      }

      match /notifications/{notificationId} {
        allow get, list: if isSelfAgent(agentId);
        allow create: if false;
        allow update: if isSelfAgent(agentId) &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isRead', 'readAt']) &&
              request.resource.data.isRead == true &&
              request.resource.data.readAt == request.time
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isRead', 'readAt', 'isCleared', 'clearedAt']) &&
              request.resource.data.isRead == true &&
              request.resource.data.readAt == request.time &&
              request.resource.data.isCleared == true &&
              request.resource.data.clearedAt == request.time
            )
          );
        allow delete: if false;
      }

      match /notificationReads/{notificationId} {
        allow get, list: if isSelfAgent(agentId);
        allow create, update: if isSelfAgent(agentId) &&
          request.resource.data.keys().hasOnly([
            'notificationId',
            'isRead',
            'readAt',
            'isCleared',
            'clearedAt'
          ]) &&
          request.resource.data.notificationId == notificationId &&
          request.resource.data.isRead == true &&
          request.resource.data.readAt == request.time &&
          (
            !request.resource.data.keys().hasAny(['isCleared', 'clearedAt']) ||
            (
              request.resource.data.isCleared == true &&
              request.resource.data.clearedAt == request.time
            )
          );
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
