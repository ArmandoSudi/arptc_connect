rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function authAgentPath() {
      return /databases/(default)/documents/agents/$(request.auth.uid);
    }

    function authAgentEmailPath() {
      return /databases/(default)/documents/agents/$(request.auth.token.email);
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function hasAuthAgentDocument() {
      return signedIn() && firestore.exists(authAgentPath());
    }

    function hasAuthAgentEmailDocument() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email != '' &&
        firestore.exists(authAgentEmailPath());
    }

    function hasUserDocument() {
      return signedIn() && firestore.exists(userPath());
    }

    function principalData() {
      return hasAuthAgentDocument()
        ? firestore.get(authAgentPath()).data
        : (
          hasAuthAgentEmailDocument()
            ? firestore.get(authAgentEmailPath()).data
            : (
              hasUserDocument()
                ? firestore.get(userPath()).data
                : request.auth.token
            )
        );
    }

    function itsmRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['ticketing'])
        ? permissions.ticketing
        : (
          permissions.keys().hasAny(['itsm'])
            ? permissions.itsm
            : (
              permissions.keys().hasAny(['it_service_management'])
                ? permissions.it_service_management
                : (
                  permissions.keys().hasAny(['itservicemanagement'])
                    ? permissions.itservicemanagement
                    : (
                      permissions.keys().hasAny(['support'])
                        ? permissions.support
                        : (
                          permissions.keys().hasAny(['incident'])
                            ? permissions.incident
                            : (
                              permissions.keys().hasAny(['incidents'])
                                ? permissions.incidents
                                : (
                                  permissions.keys().hasAny(['incident_management'])
                                    ? permissions.incident_management
                                    : (
                                      permissions.keys().hasAny(['incidentmanagement'])
                                        ? permissions.incidentmanagement
                                        : (
                                          permissions.keys().hasAny(['ticket'])
                                            ? permissions.ticket
                                            : (
                                              permissions.keys().hasAny(['tickets'])
                                                ? permissions.tickets
                                                : 'NONE'
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        );
    }

    function isItsmUser() {
      return itsmRole() in ['USER', 'user', 'User'];
    }

    function isItsmManager() {
      return itsmRole() in ['MANAGER', 'manager', 'Manager'];
    }

    function isItsmAdmin() {
      return itsmRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function assetExists(assetId) {
      return firestore.exists(
        /databases/(default)/documents/assets/$(assetId)
      );
    }

    function assetAttachmentPath(assetId, resourceKind, resourceId) {
      return /databases/(default)/documents/assets/$(assetId)/$(resourceKind)/$(resourceId);
    }

    function assetAttachmentExists(assetId, resourceKind, resourceId) {
      return firestore.exists(
        assetAttachmentPath(assetId, resourceKind, resourceId)
      );
    }

    function assetAttachmentData(assetId, resourceKind, resourceId) {
      return firestore.get(
        assetAttachmentPath(assetId, resourceKind, resourceId)
      ).data;
    }

    function stockSupportingDocumentPath(attachmentId) {
      return /databases/(default)/documents/stockSupportingDocuments/$(attachmentId);
    }

    function stockSupportingDocumentExists(attachmentId) {
      return firestore.exists(stockSupportingDocumentPath(attachmentId));
    }

    function stockSupportingDocumentData(attachmentId) {
      return firestore.get(stockSupportingDocumentPath(attachmentId)).data;
    }

    function stockItemExists(stockItemId) {
      return firestore.exists(
        /databases/(default)/documents/stockItems/$(stockItemId)
      );
    }

    function contractExists(contractId) {
      return firestore.exists(
        /databases/(default)/documents/supplierContracts/$(contractId)
      );
    }

    function contractAttachmentPath(contractId, attachmentId) {
      return /databases/(default)/documents/supplierContracts/$(contractId)/attachments/$(attachmentId);
    }

    function contractAttachmentExists(contractId, attachmentId) {
      return firestore.exists(contractAttachmentPath(contractId, attachmentId));
    }

    function contractAttachmentData(contractId, attachmentId) {
      return firestore.get(contractAttachmentPath(contractId, attachmentId)).data;
    }

    function warrantyExists(warrantyId) {
      return firestore.exists(
        /databases/(default)/documents/warranties/$(warrantyId)
      );
    }

    function warrantyAttachmentPath(warrantyId, attachmentId) {
      return /databases/(default)/documents/warranties/$(warrantyId)/attachments/$(attachmentId);
    }

    function warrantyAttachmentExists(warrantyId, attachmentId) {
      return firestore.exists(warrantyAttachmentPath(warrantyId, attachmentId));
    }

    function warrantyAttachmentData(warrantyId, attachmentId) {
      return firestore.get(warrantyAttachmentPath(warrantyId, attachmentId)).data;
    }

    function isRestrictedItsmData(data) {
      return (
          data.keys().hasAny(['confidentiality']) &&
          data.confidentiality in [
            'RESTRICTED',
            'restricted',
            'SECURITY_RESTRICTED',
            'security_restricted',
            'CONFIDENTIAL',
            'confidential'
          ]
        ) ||
        (
          data.keys().hasAny(['isRestricted']) &&
          data.isRestricted == true
        );
    }

    function isExplicitlyAuthorizedForRestricted(data) {
      return signedIn() &&
        (
          (
            data.keys().hasAny(['authorizedUserIds']) &&
            data.authorizedUserIds is list &&
            request.auth.uid in data.authorizedUserIds
          ) ||
          (
            data.keys().hasAny(['authorizedManagerIds']) &&
            data.authorizedManagerIds is list &&
            request.auth.uid in data.authorizedManagerIds
          ) ||
          (
            data.keys().hasAny(['assignedUserId']) &&
            data.assignedUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requesterId']) &&
            data.requesterId == request.auth.uid
          )
        );
    }

    function isPrincipalWorkItemOwner(data) {
      return signedIn() &&
        (
          (
            data.keys().hasAny(['requesterId']) &&
            data.requesterId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requesterEmail']) &&
            data.requesterEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['requestedForUserId']) &&
            data.requestedForUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['requestedForEmail']) &&
            data.requestedForEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['createdByUserId']) &&
            data.createdByUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['createdByEmail']) &&
            data.createdByEmail == request.auth.token.email
          ) ||
          (
            data.keys().hasAny(['affectedUserId']) &&
            data.affectedUserId == request.auth.uid
          ) ||
          (
            data.keys().hasAny(['affectedUserEmail']) &&
            data.affectedUserEmail == request.auth.token.email
          )
        );
    }

    function isActiveWorkItem(data) {
      return (
          data.keys().hasAny(['lifecycleState']) &&
          data.lifecycleState in ['active', 'ACTIVE']
        ) ||
        (
          !data.keys().hasAny(['lifecycleState']) &&
          (
            !data.keys().hasAny(['status']) ||
            !(data.status in [
              'closed',
              'CLOSED',
              'archived',
              'ARCHIVED',
              'cancelled',
              'CANCELLED'
            ])
          )
        );
    }

    function isItsmWorkItemCollection(collectionName) {
      return collectionName in [
        'incidentTickets',
        'serviceRequests',
        'changeRequests'
      ];
    }

    function workItemData(collectionName, workItemId) {
      return firestore.get(
        /databases/(default)/documents/$(collectionName)/$(workItemId)
      ).data;
    }

    function canReadIncidentStorage(data) {
      return (
          isItsmManager() &&
          data.lifecycleState in ['active', 'closed']
        ) ||
        (
          (isItsmUser() || isItsmAdmin()) &&
          isPrincipalWorkItemOwner(data)
        );
    }

    function canReadChangeStorage(data) {
      return isItsmManager() ||
        (
          (isItsmUser() || isItsmAdmin()) &&
          isPrincipalWorkItemOwner(data)
        );
    }

    function canReadItsmStorageParent(collectionName, workItemId) {
      let data = workItemData(collectionName, workItemId);
      return isItsmWorkItemCollection(collectionName) &&
        (
          (
            collectionName == 'incidentTickets' &&
            canReadIncidentStorage(data)
          ) ||
          (
            collectionName == 'serviceRequests' &&
            (
              (
                isItsmManager() &&
                (
                  !isRestrictedItsmData(data) ||
                  isExplicitlyAuthorizedForRestricted(data)
                )
              ) ||
              (
                (isItsmUser() || isItsmAdmin()) &&
                isPrincipalWorkItemOwner(data) &&
                !isRestrictedItsmData(data)
              )
            )
          ) ||
          (
            collectionName == 'changeRequests' &&
            canReadChangeStorage(data)
          )
        );
    }

    function canCreateItsmAttachment(collectionName, workItemId) {
      let data = workItemData(collectionName, workItemId);
      return canReadItsmStorageParent(collectionName, workItemId) &&
        isActiveWorkItem(data) &&
        (
          isItsmManager() ||
          (
            collectionName == 'incidentTickets' &&
            (isItsmUser() || isItsmAdmin()) &&
            isPrincipalWorkItemOwner(data)
          ) ||
          (
            collectionName == 'serviceRequests' &&
            (isItsmUser() || isItsmAdmin()) &&
            isPrincipalWorkItemOwner(data) &&
            data.status == 'draft'
          ) ||
          (
            collectionName == 'changeRequests' &&
            (isItsmUser() || isItsmAdmin()) &&
            isPrincipalWorkItemOwner(data)
          )
        ) &&
        (
          isItsmManager() ||
          request.resource.metadata.isInternal == 'false'
        );
    }

    function phase5ParentData(parentCollection, parentId) {
      return firestore.get(
        /databases/(default)/documents/$(parentCollection)/$(parentId)
      ).data;
    }

    function phase5AttachmentPath(
      parentCollection,
      parentId,
      metadataCollection,
      attachmentId
    ) {
      return /databases/(default)/documents/$(parentCollection)/$(parentId)/$(metadataCollection)/$(attachmentId);
    }

    function phase5AttachmentExists(
      parentCollection,
      parentId,
      metadataCollection,
      attachmentId
    ) {
      return firestore.exists(
        phase5AttachmentPath(
          parentCollection,
          parentId,
          metadataCollection,
          attachmentId
        )
      );
    }

    function phase5AttachmentData(
      parentCollection,
      parentId,
      metadataCollection,
      attachmentId
    ) {
      return firestore.get(
        phase5AttachmentPath(
          parentCollection,
          parentId,
          metadataCollection,
          attachmentId
        )
      ).data;
    }

    function isSecurityExceptionRequesterStorage(data) {
      return signedIn() &&
        data.keys().hasAny(['requester']) &&
        data.requester is map &&
        data.requester.keys().hasAny(['userId']) &&
        data.requester.userId == request.auth.uid;
    }

    function isManagerAuthorizedForPhase5Parent(data) {
      return isItsmManager() &&
        (
          !isRestrictedItsmData(data) ||
          isExplicitlyAuthorizedForRestricted(data) ||
          (
            data.keys().hasAny(['owner']) &&
            data.owner is map &&
            data.owner.keys().hasAny(['userId']) &&
            data.owner.userId == request.auth.uid
          )
        );
    }

    function isPhase5AttachmentParentCollection(parentCollection) {
      return parentCollection in [
        'securityFindings',
        'securityExceptions',
        'assetComplianceAssessments',
        'accessReviewItems'
      ];
    }

    function canManagerAccessPhase5AttachmentParent(
      parentCollection,
      parentId
    ) {
      let data = phase5ParentData(parentCollection, parentId);
      return isPhase5AttachmentParentCollection(parentCollection) &&
        isManagerAuthorizedForPhase5Parent(data);
    }

    function canRequesterReadExceptionAttachment(
      parentCollection,
      parentId,
      attachment
    ) {
      let parent = phase5ParentData(parentCollection, parentId);
      return parentCollection == 'securityExceptions' &&
        (isItsmUser() || isItsmAdmin()) &&
        isSecurityExceptionRequesterStorage(parent) &&
        attachment.confidentiality in ['INTERNAL', 'internal'] &&
        attachment.requesterVisible == true &&
        attachment.isInternal == false;
    }

    function canReadPhase5Attachment(
      parentCollection,
      parentId,
      metadataCollection,
      attachmentId,
      fileName
    ) {
      let attachment = phase5AttachmentData(
        parentCollection,
        parentId,
        metadataCollection,
        attachmentId
      );
      return phase5AttachmentExists(
          parentCollection,
          parentId,
          metadataCollection,
          attachmentId
        ) &&
        (
          (
            canManagerAccessPhase5AttachmentParent(
              parentCollection,
              parentId
            ) &&
            (
              !isRestrictedItsmData(attachment) ||
              (
                attachment.keys().hasAny(['authorizedManagerIds']) &&
                attachment.authorizedManagerIds is list &&
                request.auth.uid in attachment.authorizedManagerIds
              )
            )
          ) ||
          canRequesterReadExceptionAttachment(
            parentCollection,
            parentId,
            attachment
          )
        ) &&
        attachment.storagePath ==
          'itsm/' + parentCollection + '/' + parentId + '/' +
          metadataCollection + '/' + attachmentId + '/' + fileName &&
        attachment.fileName == fileName &&
        attachment.contentType == resource.contentType &&
        attachment.sizeBytes == resource.size &&
        attachment.parentCollection == parentCollection &&
        attachment.parentId == parentId &&
        attachment.attachmentId == attachmentId &&
        resource.metadata.parentCollection == parentCollection &&
        resource.metadata.parentId == parentId &&
        resource.metadata.attachmentId == attachmentId &&
        resource.metadata.storagePath == attachment.storagePath &&
        resource.metadata.uploadedByUserId == attachment.uploadedByUserId &&
        resource.metadata.confidentiality == attachment.confidentiality &&
        (
          (
            attachment.requesterVisible == true &&
            resource.metadata.requesterVisible == 'true'
          ) ||
          (
            attachment.requesterVisible == false &&
            resource.metadata.requesterVisible == 'false'
          )
        ) &&
        (
          (
            attachment.isInternal == true &&
            resource.metadata.isInternal == 'true'
          ) ||
          (
            attachment.isInternal == false &&
            resource.metadata.isInternal == 'false'
          )
        ) &&
        (
          !isRestrictedItsmData(attachment) ||
          resource.metadata.authorizedManagerId in
            attachment.authorizedManagerIds
        );
    }

    function validPhase5AttachmentMetadata(
      parentCollection,
      parentId,
      attachmentId,
      fileName
    ) {
      return request.resource.metadata.parentCollection == parentCollection &&
        request.resource.metadata.parentId == parentId &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.fileName == fileName &&
        request.resource.metadata.storagePath ==
          'itsm/' + parentCollection + '/' + parentId + '/attachments/' +
          attachmentId + '/' + fileName &&
        request.resource.metadata.uploadedByUserId == request.auth.uid &&
        request.resource.metadata.confidentiality in ['internal', 'restricted'] &&
        request.resource.metadata.requesterVisible in ['true', 'false'] &&
        request.resource.metadata.isInternal in ['true', 'false'] &&
        request.resource.metadata.authorizedManagerId is string;
    }

    function hasConsistentPhase5AttachmentVisibility() {
      return (
          request.resource.metadata.confidentiality == 'internal' &&
          request.resource.metadata.requesterVisible == 'true' &&
          request.resource.metadata.isInternal == 'false' &&
          request.resource.metadata.authorizedManagerId == ''
        ) ||
        (
          request.resource.metadata.confidentiality == 'internal' &&
          request.resource.metadata.requesterVisible == 'false' &&
          request.resource.metadata.isInternal == 'true' &&
          request.resource.metadata.authorizedManagerId == ''
        ) ||
        (
          request.resource.metadata.confidentiality == 'restricted' &&
          request.resource.metadata.requesterVisible == 'false' &&
          request.resource.metadata.isInternal == 'true' &&
          request.resource.metadata.authorizedManagerId == request.auth.uid
        );
    }

    function canCreatePhase5Attachment(parentCollection, parentId) {
      let parent = phase5ParentData(parentCollection, parentId);
      return (
          canManagerAccessPhase5AttachmentParent(
            parentCollection,
            parentId
          )
        ) ||
        (
          parentCollection == 'securityExceptions' &&
          (isItsmUser() || isItsmAdmin()) &&
          isSecurityExceptionRequesterStorage(parent) &&
          request.resource.metadata.confidentiality == 'internal' &&
          request.resource.metadata.requesterVisible == 'true' &&
          request.resource.metadata.isInternal == 'false'
        );
    }

    function knowledgeArticleData(articleId) {
      return firestore.get(
        /databases/(default)/documents/knowledgeArticles/$(articleId)
      ).data;
    }

    function knowledgeVersionData(articleId, versionId) {
      return firestore.get(
        /databases/(default)/documents/knowledgeArticles/$(articleId)/versions/$(versionId)
      ).data;
    }

    function canReadKnowledgeAttachment(articleId) {
      let data = knowledgeArticleData(articleId);
      return isItsmManager() ||
        (
          (isItsmUser() || isItsmAdmin()) &&
          data.state in ['PUBLISHED', 'published'] &&
          (
            !data.keys().hasAny(['visibility']) ||
            data.visibility in [
              'EMPLOYEE',
              'employee',
              'EMPLOYEES',
              'employees',
              'ALL',
              'all'
            ]
          )
        );
    }

    function taskRole() {
      let data = principalData();
      let permissions = data.keys().hasAny(['modulePermissions'])
        ? data.modulePermissions
        : {};
      return permissions.keys().hasAny(['tasks'])
        ? permissions.tasks
        : (
          permissions.keys().hasAny(['task'])
            ? permissions.task
            : 'NONE'
        );
    }

    function isTaskAdmin() {
      return taskRole() in ['ADMIN', 'admin', 'Admin'];
    }

    function canManageTasks() {
      return taskRole() in [
        'USER',
        'user',
        'User',
        'MANAGER',
        'manager',
        'Manager'
      ];
    }

    function principalDepartmentId() {
      let data = principalData();
      return data.keys().hasAny(['departmentId']) &&
        data.departmentId is string &&
        data.departmentId != ''
          ? data.departmentId
          : (
            data.keys().hasAny(['department']) &&
            data.department is string &&
            data.department != ''
              ? data.department
              : (
                data.keys().hasAny(['direction']) &&
                data.direction is string
                  ? data.direction
                  : ''
              )
          );
    }

    function hasSupportedContentType(contentType) {
      return contentType.matches('image/.*') ||
        contentType == 'application/pdf' ||
        contentType == 'application/msword' ||
        contentType == 'application/vnd.ms-excel' ||
        contentType == 'application/vnd.ms-powerpoint' ||
        contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
        contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
        contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation' ||
        contentType == 'text/plain' ||
        contentType == 'text/csv';
    }

    function canReadTaskFile() {
      return signedIn() &&
        (
          isTaskAdmin() ||
          (
            canManageTasks() &&
            principalDepartmentId() != '' &&
            resource.metadata.departmentId == principalDepartmentId()
          )
        );
    }

    function validTaskFileUpload(taskId) {
      return signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        request.resource.metadata.taskId == taskId &&
        request.resource.metadata.departmentId == principalDepartmentId() &&
        request.resource.metadata.uploadedByUserId == request.auth.uid;
    }

    match /tasks/{taskId}/{category}/{fileName} {
      allow read: if canReadTaskFile();
      allow create: if validTaskFileUpload(taskId) &&
        category in ['mail-scans', 'reports'];
      allow update: if false;
      allow delete: if signedIn() &&
        canManageTasks() &&
        principalDepartmentId() != '' &&
        resource.metadata.departmentId == principalDepartmentId();
    }

    match /itsm/{workItemCollection}/{workItemId}/attachments/{attachmentId}/{fileName} {
      allow read: if signedIn() &&
        canReadItsmStorageParent(workItemCollection, workItemId) &&
        (
          !resource.metadata.keys().hasAny(['isInternal']) ||
          resource.metadata.isInternal == 'false' ||
          isItsmManager()
        );

      allow create: if signedIn() &&
        resource == null &&
        canCreateItsmAttachment(workItemCollection, workItemId) &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        request.resource.metadata.workItemCollection == workItemCollection &&
        request.resource.metadata.workItemId == workItemId &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.uploadedByUserId == request.auth.uid &&
        request.resource.metadata.documentRequirementKey is string &&
        request.resource.metadata.isInternal in ['true', 'false'];

      allow update, delete: if false;
    }

    match /itsm/{parentCollection}/{parentId}/attachments/{attachmentId}/{fileName} {
      allow read: if signedIn() &&
        canReadPhase5Attachment(
          parentCollection,
          parentId,
          'attachments',
          attachmentId,
          fileName
        );
      allow create: if signedIn() &&
        resource == null &&
        isPhase5AttachmentParentCollection(parentCollection) &&
        canCreatePhase5Attachment(parentCollection, parentId) &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        validPhase5AttachmentMetadata(
          parentCollection,
          parentId,
          attachmentId,
          fileName
        ) &&
        hasConsistentPhase5AttachmentVisibility();
      allow update, delete: if false;
    }

    match /itsm/knowledgeArticles/{articleId}/versions/{versionId}/attachments/{attachmentId}/{fileName} {
      allow read: if signedIn() &&
        canReadKnowledgeAttachment(articleId) &&
        (
          !resource.metadata.keys().hasAny(['isInternal']) ||
          resource.metadata.isInternal == 'false' ||
          isItsmManager()
        );

      allow create: if signedIn() &&
        isItsmManager() &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        knowledgeArticleData(articleId).state in ['DRAFT', 'draft'] &&
        knowledgeArticleData(articleId).currentVersionId == versionId &&
        knowledgeVersionData(articleId, versionId).state in ['DRAFT', 'draft'] &&
        request.resource.metadata.articleId == articleId &&
        request.resource.metadata.versionId == versionId &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.uploadedByUserId == request.auth.uid &&
        request.resource.metadata.isInternal in ['true', 'false'];

      allow update, delete: if false;
    }

    // Legacy unversioned Knowledge objects remain readable, but new uploads
    // must use the immutable version-scoped path above.
    match /itsm/knowledgeArticles/{articleId}/attachments/{attachmentId}/{fileName} {
      allow read: if signedIn() && canReadKnowledgeAttachment(articleId);
      allow create, update, delete: if false;
    }

    match /itsm/assets/{assetId}/{resourceKind}/{resourceId}/{fileName} {
      allow read: if signedIn() &&
        isItsmManager() &&
        resourceKind in ['attachments', 'photographs'] &&
        assetExists(assetId) &&
        assetAttachmentExists(assetId, resourceKind, resourceId) &&
        assetAttachmentData(assetId, resourceKind, resourceId).assetId == assetId &&
        assetAttachmentData(assetId, resourceKind, resourceId).resourceKind == resourceKind &&
        assetAttachmentData(assetId, resourceKind, resourceId).resourceId == resourceId &&
        assetAttachmentData(assetId, resourceKind, resourceId).storagePath ==
          'itsm/assets/' + assetId + '/' + resourceKind + '/' + resourceId + '/' + fileName &&
        assetAttachmentData(assetId, resourceKind, resourceId).fileName == fileName &&
        assetAttachmentData(assetId, resourceKind, resourceId).contentType == resource.contentType &&
        assetAttachmentData(assetId, resourceKind, resourceId).sizeBytes == resource.size &&
        assetAttachmentData(assetId, resourceKind, resourceId).uploadedByUserId ==
          resource.metadata.uploadedByUserId;

      allow create: if signedIn() &&
        isItsmManager() &&
        resource == null &&
        assetExists(assetId) &&
        resourceKind in ['attachments', 'photographs'] &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        (resourceKind != 'photographs' ||
          request.resource.contentType.matches('image/.*')) &&
        request.resource.metadata.assetId == assetId &&
        request.resource.metadata.resourceId == resourceId &&
        request.resource.metadata.resourceKind == resourceKind &&
        request.resource.metadata.uploadedByUserId == request.auth.uid &&
        request.resource.metadata.isInternal in ['true', 'false'];

      allow update, delete: if false;
    }

    match /itsm/stock/{stockItemId}/supportingDocuments/{attachmentId}/{fileName} {
      allow read: if signedIn() &&
        isItsmManager() &&
        stockItemExists(stockItemId) &&
        stockSupportingDocumentExists(attachmentId) &&
        stockSupportingDocumentData(attachmentId).stockItemId == stockItemId &&
        stockSupportingDocumentData(attachmentId).attachmentId == attachmentId &&
        stockSupportingDocumentData(attachmentId).storagePath ==
          'itsm/stock/' + stockItemId + '/supportingDocuments/' +
          attachmentId + '/' + fileName &&
        stockSupportingDocumentData(attachmentId).fileName == fileName &&
        stockSupportingDocumentData(attachmentId).contentType == resource.contentType &&
        stockSupportingDocumentData(attachmentId).sizeBytes == resource.size &&
        stockSupportingDocumentData(attachmentId).uploadedByUserId ==
          resource.metadata.uploadedByUserId;

      allow create: if signedIn() &&
        isItsmManager() &&
        resource == null &&
        stockItemExists(stockItemId) &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        request.resource.metadata.stockItemId == stockItemId &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.uploadedByUserId == request.auth.uid;

      allow update, delete: if false;
    }

    match /itsm/contracts/{contractId}/attachments/{attachmentId}/{fileName} {
      allow read: if signedIn() &&
        isItsmManager() &&
        contractExists(contractId) &&
        contractAttachmentExists(contractId, attachmentId) &&
        contractAttachmentData(contractId, attachmentId).contractId == contractId &&
        contractAttachmentData(contractId, attachmentId).attachmentId == attachmentId &&
        contractAttachmentData(contractId, attachmentId).storagePath ==
          'itsm/contracts/' + contractId + '/attachments/' +
          attachmentId + '/' + fileName &&
        contractAttachmentData(contractId, attachmentId).fileName == fileName &&
        contractAttachmentData(contractId, attachmentId).contentType == resource.contentType &&
        contractAttachmentData(contractId, attachmentId).sizeBytes == resource.size &&
        contractAttachmentData(contractId, attachmentId).uploadedByUserId ==
          resource.metadata.uploadedByUserId;
      allow create: if signedIn() &&
        isItsmManager() &&
        resource == null &&
        contractExists(contractId) &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        request.resource.metadata.contractId == contractId &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.uploadedByUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /itsm/warranties/{warrantyId}/attachments/{attachmentId}/{fileName} {
      allow read: if signedIn() &&
        isItsmManager() &&
        warrantyExists(warrantyId) &&
        warrantyAttachmentExists(warrantyId, attachmentId) &&
        warrantyAttachmentData(warrantyId, attachmentId).warrantyId == warrantyId &&
        warrantyAttachmentData(warrantyId, attachmentId).attachmentId == attachmentId &&
        warrantyAttachmentData(warrantyId, attachmentId).storagePath ==
          'itsm/warranties/' + warrantyId + '/attachments/' +
          attachmentId + '/' + fileName &&
        warrantyAttachmentData(warrantyId, attachmentId).fileName == fileName &&
        warrantyAttachmentData(warrantyId, attachmentId).contentType == resource.contentType &&
        warrantyAttachmentData(warrantyId, attachmentId).sizeBytes == resource.size &&
        warrantyAttachmentData(warrantyId, attachmentId).uploadedByUserId ==
          resource.metadata.uploadedByUserId;
      allow create: if signedIn() &&
        isItsmManager() &&
        resource == null &&
        warrantyExists(warrantyId) &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        hasSupportedContentType(request.resource.contentType) &&
        request.resource.metadata.warrantyId == warrantyId &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.uploadedByUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
